# =============================================================================
# Meridian Technologies (demo) — the Verified Employer
# =============================================================================
# It gets its ECS-Organization credential from ecs-org-issuer, issues its own
# ECS-Service credential, holds the Verified Employer credential that
# Orchestrating Identity issues under the Recruitment Trust Network, and holds
# VERIFIER entries on the three candidate schemas, validated by Orchestrating
# Identity (a certified grantor). The release name is meridian-tech, because
# the verandia cast has the release "meridian-bank". The host stays meridian.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="meridian-tech"
INGRESS_HOST="meridian.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-meridian.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="meridian"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Meridian Technologies (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/meridian-tech.svg"
ORG_REGISTRY_ID="UK-CH-00224466"
ORG_ADDRESS="1 Silicon Roundabout, London, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Meridian Technologies (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Employer (demo): careers portal and ATS - Apply with Verifiable Credentials, backed by a resolvable credential chain"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/meridian-tech.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Verified Employer credential claims. Orchestrating Identity puts them in
# the credential when it validates the HOLDER entry of Meridian.
VE_COMPANY_NAME="Meridian Technologies Ltd (demo)"
VE_COMPANY_REGISTRY_ID="UK-CH-00224466"
VE_VERIFIED_DATE="2026-08-01"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="verifier"
