# =============================================================================
# Caledonian University (demo) — awarding body, Qualification registry owner
# =============================================================================
# Receives ECS-Organization from OID, self-issues ECS-Service, and owns the
# Qualification registry + schema: one credential per qualification, degrees
# and professional certifications alike. Cirrus joins as a second accredited
# issuer in bhi-07.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="caledonian"
INGRESS_HOST="caledonian.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-caledonian.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Caledonian University (demo)"
ORG_COUNTRY="GB"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/caledonian.svg"
ORG_REGISTRY_ID="UK-EDU-000123"
ORG_ADDRESS="University Avenue, Glasgow, United Kingdom"

# Service credential claims
SERVICE_NAME="Caledonian University (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Awarding body (demo): issues Qualification credentials and governs the Qualification registry"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/caledonian.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Qualification registry)
SCHEMA_FILE="qualification.json"
CUSTOM_SCHEMA_BASE_ID="qualification"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail
OID4VC_ROLE=issuer-qualification
