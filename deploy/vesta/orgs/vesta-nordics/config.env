# =============================================================================
# Vesta Nordics (demo) — subsidiary, Authorized Repairer issuer
# =============================================================================
# A standalone organization with an ISSUER entry on the Authorized Repairer
# schema of the Vesta Repair Network.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="vesta-nordics"
INGRESS_HOST="vesta-nordics.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-subsidiary.sh"

# The organization of the agent: its Corporation owns the Participant entries.
CORPORATION_KEY="nordics"

# Agent mode: standalone (its own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Vesta Nordics (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="SE"
ORG_REGISTRY_ID="SE-556677-8899"
ORG_REGISTRY_URI="https://www.bolagsverket.se"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-nordics.svg"
ORG_ADDRESS="Sveavagen 44, 111 34 Stockholm, Sweden"

# Service credential claims (self-issued)
SERVICE_NAME="Vesta Nordics (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Vesta Appliances subsidiary accrediting Authorized Repairers in the Nordics (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-nordics.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
