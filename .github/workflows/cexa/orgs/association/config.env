# =============================================================================
# Crypto Exchange Association (demo) — the Ecosystem of the CEXA cast
# =============================================================================
# The agent of the Association (standalone). It gets its ECS Organization
# credential from ecs-org-issuer (the devnet ECS Ecosystem) and issues its own
# ECS Service credential. The Association is NOT an ECS Organization issuer
# (EGF section 4). It controls the Ecosystem "Crypto Exchange Association
# (demo)" with the CEXAKycCredential schema (governed on both sides) and the
# CEXAVerifiedCounterpartyCredential schema. The agent publishes the VTJSC of
# each schema. The EGF document is served by the playground itself.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="association"
INGRESS_HOST="association.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-association.sh"

# The Corporation of the organization (did:example:playground-cexa-<key>-<chain id>).
CORPORATION_KEY="association"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Crypto Exchange Association (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="CH"
ORG_REGISTRY_URI="https://www.zefix.ch"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-association.svg"
ORG_REGISTRY_ID="CHE-300.100.100"
ORG_ADDRESS="Trust Plaza 1, 6300 Zug, Switzerland"

# Service credential claims (self-issued)
SERVICE_NAME="Crypto Exchange Association (demo)"
SERVICE_TYPE="TrustRegistryService"
SERVICE_DESCRIPTION="Agent of the Crypto Exchange Association (demo): controls the CEXA Ecosystem, its CEXAKycCredential and CEXAVerifiedCounterpartyCredential schemas, and anchors the example EGF"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-association.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# The EGF document of the Corporation and of the Ecosystem. The chain keeps
# its digest, so the URL must answer before cexa-01 runs: run Deploy
# Playground for the network first.
EGF_DOC_URL="https://playground.__NETWORK__.verana.network/cexa/cexa-egf-v4.md"
