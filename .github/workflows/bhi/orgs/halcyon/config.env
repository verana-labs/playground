# =============================================================================
# Halcyon Talent (demo) — the impostor with real credentials
# =============================================================================
# Halcyon IS a verifiable organisation: ECS-Organization from OID and a
# self-issued ECS-Service, so Q1 resolves TRUSTED. What it never gets -
# deliberately, ever - is a Verified Employer credential or a VERIFIER
# permission on the candidate schemas: every compliant wallet refuses its
# requests before any data moves. Legitimate organisation, wrong network.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="halcyon"
INGRESS_HOST="halcyon.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-halcyon.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Halcyon Talent (demo)"
ORG_COUNTRY="GB"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/halcyon.svg"
ORG_REGISTRY_ID="UK-CH-00998877"
ORG_ADDRESS="99 Fast Lane, Birmingham, United Kingdom"

# Service credential claims
SERVICE_NAME="Halcyon Talent (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Recruitment agency (demo): a verifiable organisation with no Verified Employer credential and no verifier permissions"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/halcyon.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail: Halcyon still mints very real presentation requests - the
# refusal must happen in the wallet on the missing permissions, not because
# its request button is dead. The overasking template requests the full
# credential set, portrait included.
OID4VC_ROLE=verifier-overasking
OID4VC_ISSUER_RELEASES="northbank caledonian cirrus"
