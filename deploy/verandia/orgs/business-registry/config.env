# =============================================================================
# National Business Registry (demo) — the company register of the Republic
# =============================================================================
# A standalone agent with its own Corporation. ecs-org-issuer (the ECS
# ecosystem of the network) issues its ECS Organization credential, and the
# agent issues its own ECS Service credential. On V4 the register is not an
# ISSUER of the ECS Organization schema: ecs-org-issuer issues the ECS
# Organization credential of every Verandia organization.
#
# The register controls the Legal Representation Ecosystem with the Legal
# Representative schema: issuers onboard through the Ecosystem, verifiers are
# OPEN, holders are PERMISSIONLESS (personal wallets). The register holds the
# only ISSUER entry on the schema, and issues on both rails (AnonCreds over
# DIDComm, SD-JWT over OpenID4VC).

USER_ACC="verandia-playground-admin"
RELEASE_NAME="business-registry"
INGRESS_HOST="business-registry.verandia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-registry.sh"

# The Corporation of the organization (see cast.sh)
CORPORATION_KEY="business-registry"

# Agent mode: standalone (own ECS Organization credential)
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="National Business Registry (demo)"
ORG_ORGANIZATION_KIND="PUBLIC"
ORG_COUNTRY_CODE="VD"
ORG_REGISTRY_URI="https://business-registry.verandia.playground.__NETWORK__.verana.network"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/business-registry.svg"
ORG_REGISTRY_ID="VD-GOV-0001"
ORG_ADDRESS="Praca do Comercio 2, 1000 Alvorada, Republic of Verandia"

# Service credential claims (self-issued)
SERVICE_NAME="National Business Registry (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Company register of the Republic of Verandia: Legal Representative credentials (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/business-registry.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Ecosystem configuration (Legal Representation)
SCHEMA_FILE="legal-representative.json"
SCHEMA_VERIFIER_MODE="OPEN"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="issuer"
