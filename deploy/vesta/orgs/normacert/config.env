# =============================================================================
# NormaCert (demo) — accredited certification body
# =============================================================================
# A standalone organization with an ISSUER entry on the ISO 9001-style (demo)
# schema. It issues the ISO credential to the Vesta anchor when vesta-03
# runs. The ISO_* claims of that credential are in vesta/config.env.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="normacert"
INGRESS_HOST="normacert.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-normacert.sh"

# The organization of the agent: its Corporation owns the Participant entries.
CORPORATION_KEY="normacert"

# Agent mode: standalone (its own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="NormaCert (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="FR"
ORG_REGISTRY_ID="RCS-512.345.678"
ORG_REGISTRY_URI="https://www.infogreffe.fr"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/normacert.svg"
ORG_ADDRESS="8 Rue de la Certification, 75011 Paris, France"

# Service credential claims (self-issued)
SERVICE_NAME="NormaCert (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Certification body issuing ISO 9001-style (demo) credentials"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/normacert.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
