# =============================================================================
# NormaCert (demo) — accredited certification body
# =============================================================================
# Receives ECS-Organization from Helvetia, self-issues ECS-Service, gets an
# ISSUER accreditation on the ISO 9001-style (demo) schema, and issues the
# certification credential to the Vesta anchor.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="normacert"
INGRESS_HOST="normacert.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-normacert.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="NormaCert (demo)"
ORG_COUNTRY="FR"
ORG_LOGO_URL="https://verana.io/logo.svg"
ORG_REGISTRY_ID="RCS-512.345.678"
ORG_ADDRESS="8 Rue de la Certification, 75011 Paris, France"

# Service credential claims
SERVICE_NAME="NormaCert (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Certification body issuing ISO 9001-style (demo) credentials"
SERVICE_LOGO_URL="https://verana.io/logo.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# ISO 9001-style (demo) certificate issued to the Vesta anchor
ISO_SCHEMA_BASE_ID="iso-9001-demo"
ISO_CERT_NUMBER="NC-9001-2417"
ISO_STANDARD="ISO 9001:2015 (demo)"
ISO_SCOPE="Design, manufacture and after-sales service of home appliances"
ISO_VALID_UNTIL="2027-12-31"
