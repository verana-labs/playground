# =============================================================================
# Novara Bank (demo) — bank member, ISSUER + VERIFIER (the corridor)
# =============================================================================
# A retail bank (standalone agent) under the same EGF as the exchanges. It
# issues the CEXAKycCredential to its customers for free, accepts the
# credentials of the exchanges when a customer opens an account, and gets the
# reuse fee when its credentials circulate. It gets its ECS Organization
# credential from ecs-org-issuer and its CEXAVerifiedCounterpartyCredential
# from the Association.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="novara"
INGRESS_HOST="novara.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-member.sh"

# The Corporation of the organization (did:example:playground-cexa-<key>-<chain id>).
CORPORATION_KEY="novara"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# CEXAKycCredential Participant entries of this member: issuer and/or verifier
MEMBER_ROLES="issuer verifier"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Novara Bank (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="IT"
ORG_REGISTRY_URI="https://www.registroimprese.it"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-novara.svg"
ORG_REGISTRY_ID="MI-2534891"
ORG_ADDRESS="Via Manzoni 12, 20121 Milano, Italy"

# Service credential claims (self-issued)
SERVICE_NAME="Novara Bank (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="CEXA bank member (demo), accredited to issue and verify the CEXAKycCredential - the bank-exchange corridor"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-novara.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CEXAVerifiedCounterpartyCredential claims (issued by the Association, EGF section 10)
CP_LEGAL_NAME="Novara Bank S.p.A. (demo)"
CP_LEI="529900NOVARADEMO0031"
CP_LICENSING_AUTHORITY="Banca d'Italia (demo)"
CP_LICENSE_IDENTIFIER="IT-CI-08841"
CP_VASP_CATEGORY="credit institution"
CP_COMPLIANCE_CONTACT="compliance@novara.example"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin. Novara issues and
# verifies. On V4 the plugin does the two roles when the value is not empty;
# the agent takes the credential types, the vct and the trust decision from
# the VPR.
OID4VC_ROLE="issuer verifier"
