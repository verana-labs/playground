# =============================================================================
# Accredited Issuer (demo) — TRUSTED, accredited to issue the DemoCredential
# =============================================================================
# Delegated ECS-Service issued by the Playground Demo anchor (inherits the
# Playground Organization ECS-Org). Holds an ecosystem-validated ISSUER
# permission on the DemoCredential schema: the Q2-pass card of every
# user-wallet playground page.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-issuer-accredited"
INGRESS_HOST="demo-issuer-accredited.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-demo-service.sh"
EXPOSE_ADMIN_API="false"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.12"

# Service credential claims (issued by the Playground Demo anchor)
SERVICE_NAME="Accredited Issuer (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Playground demo service authorized to issue the DemoCredential in the Playground Ecosystem (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-issuer.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DemoCredential permission for this service: issuer | verifier | none
DEMO_PERM="issuer"

# AnonCreds cred def for the DemoCredential (linked to the ecosystem VTJSC)
DEMO_CREDDEF="true"

# OpenID4VC SD-JWT rail: run the openid4vc image with the issuer config
OID4VC_ROLE="issuer"
