# =============================================================================
# Better Hiring Institute — the anchor + the Recruitment Trust Network (REAL)
# =============================================================================
# The real sector body appears as itself. Receives ECS-Organization from OID
# (Council-accredited, DVS-certified), self-issues ECS-Service, and governs
# the Recruitment Trust Network: two schemas, both about organisations.
# Recognised RecTech Provider is issued by BHI (ECOSYSTEM issuance); Verified
# Employer by the certified DVS providers (OID + TVS get ISSUER permissions).
# Verification of both is OPEN, per the source spec.
# PENDING: the CIC registration number below is from the source dossier —
# confirm with BHI before a provision run intended to stick.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="institute"
INGRESS_HOST="institute.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-institute.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Better Hiring Institute"
ORG_COUNTRY="GB"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/institute.svg"
ORG_REGISTRY_ID="CIC-104403"
ORG_ADDRESS="London, United Kingdom"

# Service credential claims
SERVICE_NAME="Better Hiring Institute"
SERVICE_TYPE="EcosystemService"
SERVICE_DESCRIPTION="Sector body for faster, fairer, safer hiring in the UK: governs the Recruitment Trust Network (demo network on the Verana testnet)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/institute.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (the Recruitment Trust Network)
RRP_SCHEMA_FILE="recognised-rectech-provider.json"
RRP_SCHEMA_BASE_ID="recognised-rectech-provider"
VE_SCHEMA_FILE="verified-employer.json"
VE_SCHEMA_BASE_ID="verified-employer"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
