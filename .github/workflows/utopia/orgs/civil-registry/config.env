# =============================================================================
# National Civil Registry (demo) — the Republic's identity authority
# =============================================================================
# Receives ECS-Organization from the National Business Registry (the Republic
# dogfoods its own register), self-issues ECS-Service, and owns the Utopia
# Citizen ID trust registry. Both directions are governed: issuance (only the
# Civil Registry issues) AND verification (relying parties must register as
# VERIFIER before any wallet shares a Citizen ID — the eIDAS 2 relying-party
# rule, made structural).

USER_ACC="utopia-playground-admin"
RELEASE_NAME="civil-registry"
INGRESS_HOST="civil-registry.utopia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-civil-registry.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="National Civil Registry (demo)"
ORG_COUNTRY="UT"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/civil-registry.svg"
ORG_REGISTRY_ID="UT-GOV-0002"
ORG_ADDRESS="Avenida da Republica 1, 1000 Alvorada, Republica of Utopia"

# Service credential claims
SERVICE_NAME="National Civil Registry (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="National identity authority of the Republica of Utopia: issues the Utopia Citizen ID and governs its relying parties (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/civil-registry.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Utopia Citizen ID ecosystem)
SCHEMA_FILE="utopia-citizen-id.json"
CUSTOM_SCHEMA_BASE_ID="utopia-citizen-id"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT Citizen ID offers for non-DIDComm wallets — the
# eIDAS-2-compatible rail): switches the deploy to the openid4vc image/chart
# and injects the issuer config. Role names select the template under
# utopia/oid4vc/ — each Utopia issuer advertises only the credential it is
# authorized to issue.
OID4VC_ROLE=issuer-citizen-id
