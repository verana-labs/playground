# =============================================================================
# ISO Certification Ecosystem (demo) — certification trust registry
# =============================================================================
# Receives ECS-Organization from Helvetia, self-issues ECS-Service, and owns
# the certification trust registry with the ISO 9001-style (demo) schema.
# For demonstration only; not affiliated with ISO.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="iso-certification"
INGRESS_HOST="iso-certification.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-iso.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="ISO Certification Ecosystem (demo)"
ORG_COUNTRY="BE"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/iso-certification.svg"
ORG_REGISTRY_ID="BE-0456.789.123"
ORG_ADDRESS="Rue de la Loi 100, 1040 Brussels, Belgium"

# Service credential claims
SERVICE_NAME="ISO Certification Registry (demo)"
SERVICE_TYPE="TrustRegistryService"
SERVICE_DESCRIPTION="Trust registry of the ISO 9001-style certification ecosystem (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/iso-certification.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration
SCHEMA_FILE="iso-9001-demo.json"
CUSTOM_SCHEMA_BASE_ID="iso-9001-demo"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
