# =============================================================================
# Zenith Repairs (demo) — authorized partner repairer
# =============================================================================
# A standalone organization. It holds the Authorized Repairer credential from
# Vesta Iberia, and it issues ECS Badges to its technicians.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="zenith"
INGRESS_HOST="zenith.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-zenith.sh"

# The organization of the agent: its Corporation owns the Participant entries.
CORPORATION_KEY="zenith"

# Agent mode: standalone (its own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Zenith Repairs (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="PT"
ORG_REGISTRY_ID="PT-509.876.543"
ORG_REGISTRY_URI="https://justica.gov.pt"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/zenith.svg"
ORG_ADDRESS="Avenida da Liberdade 110, 1250-146 Lisbon, Portugal"

# Service credential claims (self-issued)
SERVICE_NAME="Zenith Repairs (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Independent appliance repair company, authorized Vesta partner (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/zenith.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Authorized Repairer credential that Vesta Iberia issues to Zenith. Vesta
# Iberia sets these claims when it validates the onboarding request of Zenith.
AR_NAME="Zenith Repairs (demo)"
AR_REGION="Iberia"
AR_SINCE="2026"

# OpenID4VC rail (SD-JWT badge offers for wallets without DIDComm): turn on
# the OpenID4VC plugin.
OID4VC_ROLE="issuer"
