# =============================================================================
# Umbra Repairs (demo) — the impostor with real credentials
# =============================================================================
# Umbra is a verifiable organization: it has its ECS Organization and ECS
# Service credentials, and an OPEN ISSUER entry on the ECS Badge schema. It
# never gets the Authorized Repairer credential: only the Vesta Repair Network
# accredits repairers. The Vesta portal refuses its badges, and no seal shows
# at the front door. Umbra needs no demo flag.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="umbra"
INGRESS_HOST="umbra.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-umbra.sh"

# The organization of the agent: its Corporation owns the Participant entries.
CORPORATION_KEY="umbra"

# Agent mode: standalone (its own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Umbra Repairs (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="CH"
ORG_REGISTRY_ID="CHE-999.111.222"
ORG_REGISTRY_URI="https://www.zefix.ch"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/umbra.svg"
ORG_ADDRESS="Rue du Marche 3, 1204 Geneva, Switzerland"

# Service credential claims (self-issued)
SERVICE_NAME="Umbra Repairs (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Independent appliance repair services (demo) - not a Vesta Authorized Repairer"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/umbra.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT badge offers for wallets without DIDComm). Umbra
# issues real badges too: the portal refuses them on the membership rule.
OID4VC_ROLE="issuer"
