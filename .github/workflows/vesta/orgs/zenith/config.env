# =============================================================================
# Zenith Repairs (demo) — authorized partner repairer
# =============================================================================
# Receives ECS-Organization from Helvetia, self-issues ECS-Service, receives
# the Authorized Repairer credential from Vesta Iberia (org-to-org via Admin
# APIs), and becomes an ECS-Badge issuer for its technicians.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="zenith"
INGRESS_HOST="zenith.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-zenith.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Zenith Repairs (demo)"
ORG_COUNTRY="PT"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/zenith.svg"
ORG_REGISTRY_ID="PT-509.876.543"
ORG_ADDRESS="Avenida da Liberdade 110, 1250-146 Lisbon, Portugal"

# Service credential claims
SERVICE_NAME="Zenith Repairs (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Independent appliance repair company, authorized Vesta partner (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/zenith.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Authorized Repairer credential received from Vesta Iberia
AR_SCHEMA_BASE_ID="authorized-repairer"
AR_NAME="Zenith Repairs (demo)"
AR_REGION="Iberia"
AR_SINCE="2026"

# BADGE_SCHEMA_ID=""

# OpenID4VC rail (SD-JWT badge offers for non-DIDComm wallets): switches the
# deploy to the openid4vc image/chart and injects the issuer config.
OID4VC_ROLE=issuer
