# =============================================================================
# Caledonian University (demo) — awarding body, Qualification Ecosystem owner
# =============================================================================
# It gets its ECS-Organization credential from ecs-org-issuer, issues its own
# ECS-Service credential, and controls an Ecosystem with the Qualification
# schema: one credential for each qualification, degrees and professional
# certifications alike. Cirrus gets a second ISSUER entry in bhi-07. Verifier
# onboarding is through a GRANTOR: the certified DVS providers.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="caledonian"
INGRESS_HOST="caledonian.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-caledonian.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="caledonian"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Caledonian University (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://www.gov.uk/check-university-award-degree"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/caledonian.svg"
ORG_REGISTRY_ID="UK-EDU-000123"
ORG_ADDRESS="University Avenue, Glasgow, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Caledonian University (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Awarding body (demo): issues Qualification credentials and governs the Qualification Ecosystem"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/caledonian.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Ecosystem configuration (Qualification)
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="issuer"
