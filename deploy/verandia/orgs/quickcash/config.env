# =============================================================================
# QuickCash Loans (demo) — the over-asking verifier
# =============================================================================
# A standalone agent with its own Corporation. QuickCash IS a verifiable
# company: ecs-org-issuer (the ECS ecosystem of the network) issues its ECS
# Organization credential, and the agent issues its own ECS Service
# credential. Thus Q1 gives TRUSTED.
#
# By design, it never gets a VERIFIER entry on the Verandia Citizen ID: the
# verifier mode of that schema is ECOSYSTEM, and QuickCash never registered as
# a relying party. Every compliant wallet refuses its presentation request
# (Q3). Trust is not authorization.

USER_ACC="verandia-playground-admin"
RELEASE_NAME="quickcash"
INGRESS_HOST="quickcash.verandia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-quickcash.sh"

# The Corporation of the organization (see cast.sh)
CORPORATION_KEY="quickcash"

# Agent mode: standalone (own ECS Organization credential)
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="QuickCash Loans (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="VD"
ORG_REGISTRY_URI="https://business-registry.verandia.playground.__NETWORK__.verana.network"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/quickcash.svg"
ORG_REGISTRY_ID="VD-REG-009913"
ORG_ADDRESS="Rua Rapida 99, 1300 Alvorada, Republic of Verandia"

# Service credential claims (self-issued)
SERVICE_NAME="QuickCash Loans (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Consumer loan provider (demo) - a verifiable company with no relying-party registration for the Verandia Citizen ID"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/quickcash.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DEMO ONLY (not in the spec): the agent makes presentation requests although
# it holds no VERIFIER entry, so that wallets can show that they refuse them.
# A request that names only the VTJSC asks for every claim of the Citizen ID,
# the portrait too: the over-asking request of the story.
UNSAFE_SKIP_OWN_AUTHORIZATION="true"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="verifier"
