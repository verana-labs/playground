# =============================================================================
# Cirrus Certification (demo) — the SECOND Qualification issuer
# =============================================================================
# Receives ECS-Organization from OID, self-issues ECS-Service, and gets an
# ISSUER permission on the Qualification schema owned by Caledonian's
# registry: one credential per qualification, from any number of
# institutions.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="cirrus"
INGRESS_HOST="cirrus.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-cirrus.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Cirrus Certification (demo)"
ORG_COUNTRY="GB"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cirrus.svg"
ORG_REGISTRY_ID="UK-CH-00446688"
ORG_ADDRESS="Cloud House, Reading, United Kingdom"

# Service credential claims
SERVICE_NAME="Cirrus Certification (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Cloud certification body (demo): issues professional certifications as Qualification credentials"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cirrus.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Qualification schema (owned by Caledonian's registry)
QUAL_SCHEMA_BASE_ID="qualification"

# OpenID4VC rail (same template as Caledonian: the vct and VTJSC live at
# the schema owner's host; only the display name differs)
OID4VC_ROLE=issuer-qualification
