# =============================================================================
# DarkPool Exchange (demo) — fails Q1, the umbra of the CEXA cast
# =============================================================================
# Deliberately unprovisioned: a vs-agent with a DID and NOTHING else. No
# ECS-Organization, no ECS-Service, no membership, no permissions. It does
# run the openid4vc verifier config and make real presentation requests, so
# a wallet can be asked for documents by an exchange it cannot trust-resolve
# and refuse at Q1. Resolving as anything but UNTRUSTED is a paging incident.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="darkpool"
INGRESS_HOST="darkpool.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT=""
EXPOSE_ADMIN_API="false"
OID4VC_ROLE="verifier"
OID4VC_ISSUER_RELEASES="aurum novara"

# Only used for the DIDComm label / invitation image (what a wallet sees)
SERVICE_NAME="DarkPool Exchange (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-darkpool.svg"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.31"
