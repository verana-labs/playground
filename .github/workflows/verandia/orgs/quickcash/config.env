# =============================================================================
# QuickCash Loans (demo) — the over-asking verifier
# =============================================================================
# QuickCash IS a verifiable company: ECS-Organization from the National
# Business Registry and a self-issued ECS-Service, so Q1 resolves TRUSTED.
# What it never gets — deliberately, ever — is a VERIFIER permission on the
# Verandia Citizen ID: verification of that schema is ecosystem-governed,
# QuickCash never registered as a relying party, and every compliant wallet
# refuses its presentation request (Q3). Trust is not authorization.

USER_ACC="verandia-playground-admin"
RELEASE_NAME="quickcash"
INGRESS_HOST="quickcash.verandia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-quickcash.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="QuickCash Loans (demo)"
ORG_COUNTRY="VD"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/quickcash.svg"
ORG_REGISTRY_ID="VD-REG-009913"
ORG_ADDRESS="Rua Rapida 99, 1300 Alvorada, Republic of Verandia"

# Service credential claims
SERVICE_NAME="QuickCash Loans (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Consumer loan provider (demo) - a verifiable company with no relying-party registration for the Verandia Citizen ID"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/quickcash.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail: QuickCash still mints very real presentation requests — the
# refusal must happen in the wallet on the missing VERIFIER permission, not
# because its request button is dead. The verifier-overasking template asks
# for the FULL Citizen ID (portrait included) and pins no issuer
# fingerprints: compliant wallets never present to it anyway.
OID4VC_ROLE=verifier-overasking
