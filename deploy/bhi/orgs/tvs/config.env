# =============================================================================
# Trustworthy Verification Services (demo) — the SECOND certified grantor
# =============================================================================
# The openness argument of the story: a second certified DVS provider, with
# no relationship to Orchestrating Identity beyond the shared register. It
# gets its ECS-Organization credential from ecs-org-issuer, issues its own
# ECS-Service credential, and holds the DVS-Aligned Provider credential from
# Orchestrating Identity. It is a certified grantor of the Recruitment Trust
# Network (second pass of bhi-03), and it validates the VERIFIER entries of
# JobSearch (bhi-09).
USER_ACC="bhi-playground-admin"
RELEASE_NAME="tvs"
INGRESS_HOST="tvs.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-tvs.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="tvs"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Trustworthy Verification Services (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/tvs.svg"
ORG_REGISTRY_ID="UK-CH-00990011"
ORG_ADDRESS="12 Verification Row, Manchester, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Trustworthy Verification Services (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="A second certified DVS provider (demo): grantor in the Recruitment Trust Network - same schemas, same rules, same verdict"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/tvs.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DVS-Aligned Provider credential claims. Orchestrating Identity puts them in
# the credential when it validates the HOLDER entry of TVS.
DVS_PROVIDER_NAME="Trustworthy Verification Services (demo)"
DVS_REGISTER_STATUS="registered"
DVS_CHECKED_DATE="2026-08-01"
