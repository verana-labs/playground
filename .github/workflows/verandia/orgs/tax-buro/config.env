# =============================================================================
# Impuestos Nacionales (demo) — the Republic's tax portal, a registered relying party
# =============================================================================
# Receives ECS-Organization from the SEPREC (demo), self-issues
# ECS-Service, and registers as a VERIFIER of the Cedula Digital (verifier
# mode is ECOSYSTEM — the on-chain relying-party register). Legal
# Representative verification is OPEN, so its VERIFIER permission there is
# self-created. Powers the passwordless tax-portal login demos.

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="impuestos"
INGRESS_HOST="impuestos.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-relying-party.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Impuestos Nacionales (demo)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/impuestos.svg"
ORG_REGISTRY_ID="BO-GOV-0003"
ORG_ADDRESS="Rua do Tesouro 8, 1000 Alvorada, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="Impuestos Nacionales (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Tax portal of the Estado Plurinacional de Bolivia (demo): passwordless sign-in with the Cedula Digital or a Legal Representative credential (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/impuestos.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Bolivia schemas this relying party verifies
CITIZEN_SCHEMA_BASE_ID="cedula-digital"
LEGAL_REP_SCHEMA_BASE_ID="legal-representative"

# OpenID4VC rail (SD-JWT presentation requests): switches the deploy to the
# openid4vc image/chart and injects the verifier config. The issuers whose
# development-signing fingerprints get pinned at render time — both must
# already run the openid4vc image (deploy them before the relying parties).
OID4VC_ROLE=verifier
OID4VC_ISSUER_RELEASES="segip seprec"
