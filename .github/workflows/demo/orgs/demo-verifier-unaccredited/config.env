# =============================================================================
# Unaccredited Verifier (demo) — TRUSTED, NOT accredited for the DemoCredential
# =============================================================================
# Delegated ECS-Service issued by the Playground Demo anchor: a trusted
# Verifiable Service that holds NO Participant entry on the DemoCredential schema.
# Its presentation requests fail Q3: the sharing-blocked card of every
# user-wallet playground page.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-verifier-unaccredited"
INGRESS_HOST="demo-verifier-unaccredited.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-demo-service.sh"
EXPOSE_ADMIN_API="false"

# Agent mode: standalone (own ECS Organization credential) or delegated
# (ECS Service credential issued by the Playground Demo anchor).
AGENT_MODE="delegated"


# Service credential claims (issued by the Playground Demo anchor)
SERVICE_NAME="Unaccredited Verifier (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Playground demo service that is trusted but NOT authorized to verify the DemoCredential — its presentation requests must be refused by the wallet"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-verifier-unaccredited.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DemoCredential Participant entry of this service: issuer | verifier | none
DEMO_PERM="none"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
# (issuer fingerprints are read live from the issuer agents at deploy time)
OID4VC_ROLE="verifier"

# DEMO ONLY (not in the spec): vs-agent AGENT_UNSAFE_SKIP_OWN_AUTHORIZATION. The
# service makes offers and requests although it holds no DemoCredential
# Participant entry, so that wallets can show that they refuse them.
UNSAFE_SKIP_OWN_AUTHORIZATION="true"
