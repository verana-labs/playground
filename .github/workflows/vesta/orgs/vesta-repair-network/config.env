# =============================================================================
# Vesta Repair Network (demo) — ecosystem trust registry (sub-service of Vesta)
# =============================================================================
# Delegated ECS-Service issued by the Vesta anchor; inherits Vesta's
# ECS-Organization. Owns the Vesta Repair Network trust registry with the
# Authorized Repairer schema (issuance ecosystem-governed, verification open).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="vesta-repair-network"
INGRESS_HOST="repair-network.vesta.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-repair-network.sh"
EXPOSE_ADMIN_API="false"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.33"

# Service credential claims (issued by the Vesta anchor)
SERVICE_NAME="Vesta Repair Network (demo)"
SERVICE_TYPE="TrustRegistryService"
SERVICE_DESCRIPTION="Trust registry of the Vesta Repair Network ecosystem (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-repair-network.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration
SCHEMA_FILE="authorized-repairer.json"
CUSTOM_SCHEMA_BASE_ID="authorized-repairer"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
