# =============================================================================
# Unaccredited Issuer (demo) — TRUSTED, NOT accredited for the DemoCredential
# =============================================================================
# Delegated ECS-Service issued by the Playground Demo anchor: a perfectly
# trusted Verifiable Service that holds NO permission on the DemoCredential
# schema. Its credential offers fail Q2: the offer-blocked card of every
# user-wallet playground page.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-issuer-unaccredited"
INGRESS_HOST="demo-issuer-unaccredited.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-demo-service.sh"
EXPOSE_ADMIN_API="false"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.29"

# Service credential claims (issued by the Playground Demo anchor)
SERVICE_NAME="Unaccredited Issuer (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Playground demo service that is trusted but NOT authorized to issue the DemoCredential — its offers must be refused by the wallet"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-issuer-unaccredited.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DemoCredential permission for this service: issuer | verifier | none
DEMO_PERM="none"

# AnonCreds cred def for the DemoCredential (linked to the ecosystem VTJSC)
DEMO_CREDDEF="true"

# OpenID4VC SD-JWT rail: run the openid4vc image with the issuer config
OID4VC_ROLE="issuer"
