# =============================================================================
# Taquilla (demo) — la boletería emisora de los boletos verificables
# =============================================================================
# Broker ficticio de boletos: el asistente (o el patrocinador) se registra en
# Taquilla, paga (simulado) y recibe su boleto como credencial verificable en
# la wallet de su elección. Recibe su ECS-Organization de Helvetia Trust
# (demo), auto-emite su ECS-Service y gobierna el Ecosistema de Eventos
# (demo): dos esquemas (Asistente, Patrocinador), emisión gobernada (solo
# Taquilla emite) y verificación ABIERTA (cada evento se auto-registra como
# verificador). Los tipos AnonCreds AsistenteEvento / PatrocinadorEvento y
# los ids OID4VC eventos-asistente / eventos-patrocinador son el contrato
# con app/lib/eventos-cast.ts y /api/demo.

USER_ACC="eventos-playground-admin"
RELEASE_NAME="taquilla"
INGRESS_HOST="taquilla.eventos.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-taquilla.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Taquilla Boletería S.A.S. (demo)"
ORG_COUNTRY="CO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/eventos/cast/taquilla.png"
ORG_REGISTRY_ID="CO-CCM-TAQ-2026 (demo)"
ORG_ADDRESS="Carrera 43A No. 1-50, Medellín, Colombia (demo)"

# Service credential claims
SERVICE_NAME="Taquilla (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Boleteria de eventos (demo): el boleto es una credencial verificable en la wallet del asistente, emitida al registrarse y presentada en la puerta y en el espacio personal del evento"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/eventos/cast/taquilla.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Ecosistema de Eventos (demo): two schemas,
# one registry)
ASISTENTE_SCHEMA_FILE="asistente.json"
ASISTENTE_SCHEMA_BASE_ID="asistente"
PATROCINADOR_SCHEMA_FILE="patrocinador.json"
PATROCINADOR_SCHEMA_BASE_ID="patrocinador"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT offers for non-DIDComm wallets): switches the deploy
# to the openid4vc plugin and injects the issuer config rendered from
# eventos/oid4vc/issuer-taquilla.json.tpl.
OID4VC_ROLE=issuer-taquilla
