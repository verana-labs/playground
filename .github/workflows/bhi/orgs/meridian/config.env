# =============================================================================
# Meridian Technologies (demo) — the Verified Employer
# =============================================================================
# Receives ECS-Organization from OID (reusable KYB), self-issues ECS-Service,
# carries the Verified Employer credential issued by OID under the
# Recruitment Trust Network, and self-creates VERIFIER permissions on the
# three candidate schemas (verification OPEN). Release name meridian-tech
# because the verandia cast owns "meridian-bank"; the host stays meridian.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="meridian-tech"
INGRESS_HOST="meridian.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-meridian.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Meridian Technologies (demo)"
ORG_COUNTRY="GB"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/meridian-tech.svg"
ORG_REGISTRY_ID="UK-CH-00224466"
ORG_ADDRESS="1 Silicon Roundabout, London, United Kingdom"

# Service credential claims
SERVICE_NAME="Meridian Technologies (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Employer (demo): careers portal and ATS - Apply with Verifiable Credentials, backed by a resolvable credential chain"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/meridian-tech.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Verified Employer credential (issued by OID under the RTN)
VE_SCHEMA_BASE_ID="verified-employer"
VE_COMPANY_NAME="Meridian Technologies Ltd (demo)"
VE_COMPANY_REGISTRY_ID="UK-CH-00224466"
VE_VERIFIED_DATE="2026-08-01"

# Candidate schemas this employer verifies
RTW_SCHEMA_BASE_ID="right-to-work"
EMP_SCHEMA_BASE_ID="employment"
QUAL_SCHEMA_BASE_ID="qualification"

# OpenID4VC rail (SD-JWT presentation requests); the issuers whose
# development-signing fingerprints get pinned at render time - all three
# must already run the openid4vc image (deploy 05-07 before 08-10).
OID4VC_ROLE=verifier
OID4VC_ISSUER_RELEASES="northbank caledonian cirrus"
