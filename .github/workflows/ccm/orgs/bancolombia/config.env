# =============================================================================
# Bancolombia (demo) — el banco verificador, verificador registrado
# =============================================================================
# Recibe su ECS-Organization de la CCM (demo) (KYB en segundos: la cámara ES
# la fuente de verdad sobre las empresas de Medellín), auto-emite su
# ECS-Service, y se registra como VERIFIER de la Representación Legal
# (modo verificador ECOSYSTEM: el registro de partes confiantes de la
# cámara, con tarifa por verificación). Alimenta la demo de acceso a la
# cuenta corporativa: KYC presencial con la cédula física + presentación de
# la credencial de representación legal.

USER_ACC="ccm-playground-admin"
RELEASE_NAME="bancolombia"
INGRESS_HOST="bancolombia.ccm.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-bancolombia.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Bancolombia S.A. (demo)"
ORG_COUNTRY="CO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/ccm/bancolombia.png"
ORG_REGISTRY_ID="CCM-MAT-000123"
ORG_ADDRESS="Carrera 48 No. 26-85, Medellín, Colombia (demo)"

# Service credential claims
SERVICE_NAME="Bancolombia (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Banca empresarial (demo): apertura de cuenta con KYC presencial y acceso corporativo verificando la credencial de representacion legal de la CCM (maqueta de demostracion)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/ccm/bancolombia.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CCM schema this relying party verifies
LEGAL_REP_SCHEMA_BASE_ID="representacion-legal"

# OpenID4VC rail (SD-JWT presentation requests): switches the deploy to the
# openid4vc image/chart and injects the verifier config. The issuer whose
# development-signing fingerprint gets pinned at render time — it must
# already run the openid4vc image (deploy ccm-01 before the bank).
OID4VC_ROLE=verifier
OID4VC_ISSUER_RELEASES="camara"
