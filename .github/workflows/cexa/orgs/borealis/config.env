# =============================================================================
# Borealis Markets (demo) — VERIFIER member
# =============================================================================
# A growing exchange (standalone agent). It accepts the CEXAKycCredential on
# sign-up (re-binding, paid session and evidence at presentation) and does not
# run the check again. It gets its ECS Organization credential from
# ecs-org-issuer and its CEXAVerifiedCounterpartyCredential from the
# Association.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="borealis"
INGRESS_HOST="borealis.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-member.sh"

# The Corporation of the organization (did:example:playground-cexa-<key>-<chain id>).
CORPORATION_KEY="borealis"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# CEXAKycCredential Participant entries of this member: issuer and/or verifier
MEMBER_ROLES="verifier"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Borealis Markets (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="EE"
ORG_REGISTRY_URI="https://ariregister.rik.ee"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-borealis.svg"
ORG_REGISTRY_ID="16294901"
ORG_ADDRESS="Tornimäe 5, 10145 Tallinn, Estonia"

# Service credential claims (self-issued)
SERVICE_NAME="Borealis Markets (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="CEXA member exchange (demo), accredited to verify the CEXAKycCredential - open an account by presenting it"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-borealis.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CEXAVerifiedCounterpartyCredential claims (issued by the Association, EGF
# section 10). Borealis holds no LEI, so the credential has no lei claim.
CP_LEGAL_NAME="Borealis Markets OÜ (demo)"
CP_LEI=""
CP_LICENSING_AUTHORITY="Estonian FIU (demo)"
CP_LICENSE_IDENTIFIER="FVT000317"
CP_VASP_CATEGORY="crypto exchange"
CP_COMPLIANCE_CONTACT="compliance@borealis.example"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin. The agent takes the
# credential types and the trust decision from the VPR.
OID4VC_ROLE="verifier"
