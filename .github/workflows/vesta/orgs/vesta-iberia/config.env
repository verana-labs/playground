# =============================================================================
# Vesta Iberia (demo) — subsidiary, Authorized Repairer issuer
# =============================================================================
# Receives ECS-Organization from Helvetia, self-issues ECS-Service, and gets
# an ISSUER accreditation on the Authorized Repairer schema of the Vesta
# Repair Network. Issues the Authorized Repairer credential to Zenith Repairs.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="vesta-iberia"
INGRESS_HOST="vesta-iberia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-subsidiary.sh"
EXPOSE_ADMIN_API="false"

# --- vs-agent prerelease under test (public service profile UI) -------------
# Pins the app image (chart stays at the template's version). v1.12+ images
# enforce the Verana network config at boot, so the values below are forwarded
# as container env by vesta-00_core; the signing mnemonic comes from the
# PLAYGROUND_MNEMONIC secret.
VS_AGENT_IMAGE_TAG="v1.12.0-uiprofile.1"
VERANA_CHAIN_ID="vna-testnet-1"
VERANA_RPC_ENDPOINT_URL="https://rpc.testnet.verana.network"
VERANA_INDEXER_BASE_URL="https://idx.testnet.verana.network"
VERANA_CORPORATION_ID="1"
TRUSTED_ECS_ECOSYSTEM_DIDS="did:webvh:QmcTCdA8z7cs7BwCKyrrJrTTmvff3wmxSn7WUZtP2iAM7T:ecs-trust-registry.testnet.verana.network"
UI_NETWORK_BADGE="Testnet"

# Organization credential claims
ORG_NAME="Vesta Iberia (demo)"
ORG_COUNTRY="ES"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-iberia.svg"
ORG_REGISTRY_ID="ES-B-84123456"
ORG_ADDRESS="Calle de Alcala 200, 28028 Madrid, Spain"

# Service credential claims
SERVICE_NAME="Vesta Iberia (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Vesta Appliances subsidiary accrediting Authorized Repairers in Iberia (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-iberia.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Authorized Repairer schema (from the repair-network registry)
AR_SCHEMA_BASE_ID="authorized-repairer"
