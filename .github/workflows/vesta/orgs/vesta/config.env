# =============================================================================
# Vesta Appliances (demo) — organization anchor
# =============================================================================
# A standalone organization. It issues its own ECS Service credential and the
# ECS Service credentials of its delegated sub-services (vesta-portal,
# vesta-repair-network). It issues ECS Badges to its employees, and it holds
# the ISO 9001-style (demo) credential from NormaCert.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="vesta"
INGRESS_HOST="vesta.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-vesta-anchor.sh"

# The organization of the agent: its Corporation owns the Participant entries.
# The delegated sub-services of Vesta use the same Corporation.
CORPORATION_KEY="vesta"

# Agent mode: standalone (its own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Vesta Appliances (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="CH"
ORG_REGISTRY_ID="CHE-102.345.678"
ORG_REGISTRY_URI="https://www.zefix.ch"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta.png"
ORG_ADDRESS="Route des Acacias 45, 1227 Geneva, Switzerland"

# Service credential claims (self-issued)
SERVICE_NAME="Vesta Appliances (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Organization anchor of Vesta Appliances: badge issuance and delegated services (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-anchor.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# ISO 9001-style (demo) credential that NormaCert issues to Vesta. NormaCert
# sets these claims when it validates the onboarding request of Vesta.
ISO_CERT_NUMBER="NC-9001-2417"
ISO_STANDARD="ISO 9001:2015 (demo)"
ISO_SCOPE="Design, manufacture and after-sales service of home appliances"
ISO_VALID_UNTIL="2027-12-31"

# OpenID4VC rail (SD-JWT badge offers for wallets without DIDComm): turn on
# the OpenID4VC plugin.
OID4VC_ROLE="issuer"
