# =============================================================================
# Umbra Repairs (demo) — the impostor
# =============================================================================
# A vs-agent with a DID and NO credentials, NO permissions, NO linked VPs:
# trust resolution must fail. Provisioning only adds an unanchored ECS-Badge
# credential type so Umbra can offer badges — the wallet flags them red and
# the Vesta portal refuses them at login.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="umbra"
INGRESS_HOST="umbra.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-umbra.sh"
EXPOSE_ADMIN_API="false"

# Only used for the DIDComm label / invitation image (what a wallet sees)
SERVICE_NAME="Umbra Repairs"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/umbra.svg"

# OpenID4VC rail (SD-JWT badge offers for non-DIDComm wallets): switches the
# deploy to the openid4vc image/chart and injects the issuer config.
OID4VC_ROLE=issuer
