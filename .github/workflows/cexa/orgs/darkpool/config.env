# =============================================================================
# DarkPool Exchange (demo) — the outsider: verifiable, and NOT a member
# =============================================================================
# A real, verifiable exchange (standalone agent). It gets its ECS Organization
# credential from ecs-org-issuer and issues its own ECS Service credential,
# but it did not join the Association: it has no CEXA Participant entry and
# no CEXAVerifiedCounterpartyCredential. It asks wallets for the
# CEXAKycCredential, so that a wallet can refuse the request of a trusted
# exchange that is not authorized (Q3).
#
# CAUTION: a DarkPool entry in a CEXA participant tree, or a
# CEXAVerifiedCounterpartyCredential on its DID, is an incident.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="darkpool"
INGRESS_HOST="darkpool.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-outsider.sh"

# The Corporation of the organization (did:example:playground-cexa-<key>-<chain id>).
CORPORATION_KEY="darkpool"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="DarkPool Exchange Ltd (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="KY"
ORG_REGISTRY_URI="https://www.ciregistry.ky"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-darkpool.svg"
ORG_REGISTRY_ID="KY-338291"
ORG_ADDRESS="Harbour Place, George Town, Grand Cayman, Cayman Islands"

# Service credential claims (self-issued)
SERVICE_NAME="DarkPool Exchange (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="A real crypto exchange (demo) outside the Crypto Exchange Association: verifiable, but not accredited to ask for the CEXAKycCredential"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-darkpool.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DEMO ONLY (not in the spec): vs-agent v2 makes no request without an active
# VERIFIER entry. This flag lets DarkPool make the request, and the wallet
# must refuse it.
UNSAFE_SKIP_OWN_AUTHORIZATION="true"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin. The agent takes the
# credential types and the trust decision from the VPR.
OID4VC_ROLE="verifier"
