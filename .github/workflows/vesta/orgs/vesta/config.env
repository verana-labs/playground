# =============================================================================
# Vesta Appliances (demo) — organization anchor Business Wallet
# =============================================================================
# Receives ECS-Organization from Helvetia, self-issues ECS-Service, becomes an
# ECS-Badge issuer (employee badges) and later delegates ECS-Service
# credentials to the portal and repair-network sub-services.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="vesta"
INGRESS_HOST="vesta.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-vesta-anchor.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Vesta Appliances (demo)"
ORG_COUNTRY="CH"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta.png"
ORG_REGISTRY_ID="CHE-102.345.678"
ORG_ADDRESS="Route des Acacias 45, 1227 Geneva, Switzerland"

# Service credential claims
SERVICE_NAME="Vesta Appliances (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Organization anchor of Vesta Appliances: badge issuance and delegated services (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-anchor.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# ECS-Badge schema is discovered from the ECS trust registry; set to skip:
# BADGE_SCHEMA_ID=""
