# =============================================================================
# JobSearch (demo) — the recognised verifier, onboarded by the SECOND grantor
# =============================================================================
# It gets its ECS-Organization credential from ecs-org-issuer, issues its own
# ECS-Service credential, and holds the Recognised RecTech Provider credential
# from the Institute. Trustworthy Verification Services (demo), NOT
# Orchestrating Identity, validates its VERIFIER entries on the three
# candidate schemas: nothing the candidate sees depends on which certified
# provider did the onboarding.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="jobsearch"
INGRESS_HOST="jobsearch.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-jobsearch.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="jobsearch"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="JobSearch Ltd (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/jobsearch.svg"
ORG_REGISTRY_ID="UK-CH-00113355"
ORG_ADDRESS="Board Walk 4, Leeds, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="JobSearch (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Job board and credential-request service (demo): a recognised RecTech provider that asks only what it may"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/jobsearch.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Recognised RecTech Provider credential claims. The Institute puts them in
# the credential when it validates the HOLDER entry of JobSearch.
RRP_PROVIDER_NAME="JobSearch Ltd (demo)"
RRP_MEMBER_SINCE="2026-08-01"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="verifier"
