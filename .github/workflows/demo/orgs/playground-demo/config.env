# =============================================================================
# Playground Demo — anchor of the Playground demo cast (spec §4/§6)
# =============================================================================
# The anchor VS of the Playground Organization (demo): ECS-Organization issued
# by Helvetia (from the vesta cast, same cluster), self-issued ECS-Service,
# and owner of the Playground Ecosystem (demo) trust registry with the
# DemoCredential schema, root permission and VTJSC. The four trusted demo
# services are its delegated sub-services.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="playground-demo"
INGRESS_HOST="playground-demo.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-playground-anchor.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Playground Organization (demo)"
ORG_COUNTRY="CH"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/playground-demo.svg"
ORG_REGISTRY_ID="CHE-100.100.100"
ORG_ADDRESS="Playground Plaza 1, 8000 Zurich, Switzerland"

# Service credential claims (self-issued)
SERVICE_NAME="Playground Demo"
SERVICE_TYPE="TrustRegistryService"
SERVICE_DESCRIPTION="Anchor of the Playground Organization (demo): owns the Playground Ecosystem (demo) and its DemoCredential schema for the user-wallet playground scenarios"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/playground-demo.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration
SCHEMA_FILE="demo-credential.json"
CUSTOM_SCHEMA_BASE_ID="demo-credential"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# vs-agent prerelease under test (overrides the template image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.5"
