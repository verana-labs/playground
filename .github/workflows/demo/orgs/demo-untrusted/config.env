# =============================================================================
# Untrusted Service (demo) — fails Q1, used by both trios
# =============================================================================
# Deliberately unprovisioned (the umbra pattern): a vs-agent with a DID and
# NOTHING else. No ECS-Organization, no ECS-Service, no permissions. Serves
# both the issuer and the verifier trio on every user-wallet playground page;
# trust resolution failing on it is the Q1-fail card. This service resolving
# as anything but UNTRUSTED is a paging incident (spec §6).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-untrusted"
INGRESS_HOST="demo-untrusted.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT=""
EXPOSE_ADMIN_API="false"

# Only used for the DIDComm label / invitation image (what a wallet sees)
SERVICE_NAME="Untrusted Service (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-untrusted.svg"

# vs-agent prerelease under test (overrides the template image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.9"
