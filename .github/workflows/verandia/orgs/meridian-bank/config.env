# =============================================================================
# Meridian Bank (demo) — a verifiable bank, registered relying party
# =============================================================================
# Receives ECS-Organization from the National Business Registry (KYB in
# seconds — the issuer IS the source of truth), self-issues ECS-Service, and
# registers as a VERIFIER of the Verandia Citizen ID (verifier mode is
# ECOSYSTEM). Legal Representative verification is OPEN, so its VERIFIER
# permission there is self-created. Powers the KYC-in-one-scan and corporate
# access demos — the most-phished brand category, made provable.

USER_ACC="verandia-playground-admin"
RELEASE_NAME="meridian-bank"
INGRESS_HOST="meridian-bank.verandia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-relying-party.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Meridian Bank (demo)"
ORG_COUNTRY="VD"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/meridian-bank.svg"
ORG_REGISTRY_ID="VD-REG-001204"
ORG_ADDRESS="Avenida Meridian 40, 1200 Alvorada, Republic of Verandia"

# Service credential claims
SERVICE_NAME="Meridian Bank (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Retail bank of the Republic of Verandia: account opening and corporate access by verifiable credentials (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/meridian-bank.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Verandia schemas this relying party verifies
CITIZEN_SCHEMA_BASE_ID="verandia-citizen-id"
LEGAL_REP_SCHEMA_BASE_ID="legal-representative"

# OpenID4VC rail (SD-JWT presentation requests): switches the deploy to the
# openid4vc image/chart and injects the verifier config. The issuers whose
# development-signing fingerprints get pinned at render time — both must
# already run the openid4vc image (deploy them before the relying parties).
OID4VC_ROLE=verifier
OID4VC_ISSUER_RELEASES="civil-registry business-registry"
