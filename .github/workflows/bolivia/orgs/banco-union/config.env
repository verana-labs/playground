# =============================================================================
# Banco Unión (demo) — un banco verificable, verificador registrado
# =============================================================================
# Receives ECS-Organization from the SEPREC (demo) (KYB in
# seconds — the issuer IS the source of truth), self-issues ECS-Service, and
# registers as a VERIFIER of the Cedula Digital (verifier mode is
# ECOSYSTEM). Legal Representative verification is OPEN, so its VERIFIER
# permission there is self-created. Powers the KYC-in-one-scan and corporate
# access demos — the most-phished brand category, made provable.

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="banco-union"
INGRESS_HOST="banco-union.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-relying-party.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Banco Unión S.A. (demo)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/banco-union.png"
ORG_REGISTRY_ID="BO-MAT-001204"
ORG_ADDRESS="Calle Genaro Sanjines 622, La Paz, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="Banco Unión (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Banca en linea (demo): KYC en un escaneo con la Cedula Digital y acceso corporativo con la credencial de Representante Legal (maqueta de demostracion)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/banco-union.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Bolivia schemas this relying party verifies
CITIZEN_SCHEMA_BASE_ID="cedula-digital"
LEGAL_REP_SCHEMA_BASE_ID="legal-representative"

# OpenID4VC rail (SD-JWT presentation requests): switches the deploy to the
# openid4vc image/chart and injects the verifier config. The issuers whose
# development-signing fingerprints get pinned at render time — both must
# already run the openid4vc image (deploy them before the relying parties).
OID4VC_ROLE=verifier
OID4VC_ISSUER_RELEASES="segip seprec"
