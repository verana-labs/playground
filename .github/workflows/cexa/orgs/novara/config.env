# =============================================================================
# Novara Bank (demo) — bank member, ISSUER + VERIFIER (the corridor)
# =============================================================================
# A retail bank under the same EGF as the exchanges: credentials its existing
# KYC'd base for free, accepts exchange-issued credentials on account
# opening, and earns the reuse fee when its credentials circulate.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="novara"
INGRESS_HOST="novara.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-member.sh"
EXPOSE_ADMIN_API="false"
MEMBER_ROLES="issuer verifier"

# Organization credential claims (issued by Helvetia, Verana ECS Ecosystem)
ORG_NAME="Novara Bank (demo)"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-novara.svg"
ORG_REGISTRY_ID="MI-2534891"
ORG_ADDRESS="Via Manzoni 12, 20121 Milano, Italy"
ORG_COUNTRY="IT"

# Service credential claims (self-issued)
SERVICE_NAME="Novara Bank (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="CEXA bank member (demo), accredited to issue and verify the CEXA-Kyc credential - the bank-exchange corridor"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-novara.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CEXA-VerifiedCounterparty claims (issued by the Association, EGF section 10)
CP_LEGAL_NAME="Novara Bank S.p.A. (demo)"
CP_LEI="529900NOVARADEMO0031"
CP_LICENSING_AUTHORITY="Banca d'Italia (demo)"
CP_LICENSE_IDENTIFIER="IT-CI-08841"
CP_VASP_CATEGORY="credit institution"
CP_COMPLIANCE_CONTACT="compliance@novara.example"

# OpenID4VC SD-JWT rail: issuer config (vct on this host)
OID4VC_ROLE="issuer-novara"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.31"
