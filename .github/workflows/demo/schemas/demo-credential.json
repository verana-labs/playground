{
  "$id": "https://playground-demo.playground.testnet.verana.network/schemas/demo-credential.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemoCredential",
  "description": "The single credential of the Playground Ecosystem (demo), issued instantly to playground visitors to demonstrate the verify-first loop. For demonstration only.",
  "type": "object",
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name chosen by the visitor",
          "minLength": 1,
          "maxLength": 256
        },
        "demoId": {
          "type": "string",
          "description": "Issuer-scoped demo identifier",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "name",
        "demoId"
      ]
    }
  }
}
