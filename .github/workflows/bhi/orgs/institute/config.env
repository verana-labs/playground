# =============================================================================
# Better Hiring Institute — the anchor + the Recruitment Trust Network (REAL)
# =============================================================================
# The real sector body appears as itself. It gets its ECS-Organization
# credential from ecs-org-issuer, issues its own ECS-Service credential, and
# controls the Recruitment Trust Network: two schemas, both about
# organisations. The Institute issues Recognised RecTech Provider (issuer
# onboarding by the Ecosystem). The certified DVS providers issue Verified
# Employer (issuer onboarding through a GRANTOR: Orchestrating Identity and
# TVS hold the ISSUER_GRANTOR entries). Verifier onboarding is OPEN on both
# schemas, as in the source spec.
# PENDING: the CIC registration number below is from the source dossier —
# confirm with BHI before a provision run intended to stick.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="institute"
INGRESS_HOST="institute.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-institute.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="institute"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Better Hiring Institute"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/institute.svg"
ORG_REGISTRY_ID="CIC-104403"
ORG_ADDRESS="London, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Better Hiring Institute"
SERVICE_TYPE="EcosystemService"
SERVICE_DESCRIPTION="Sector body for faster, fairer, safer hiring in the UK: governs the Recruitment Trust Network (demo network on the Verana devnet)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/institute.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Ecosystem configuration (the Recruitment Trust Network)
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
