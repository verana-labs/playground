# =============================================================================
# Helvetia Trust Services (demo) — standalone organization
# =============================================================================
# On V4, Helvetia is an ordinary member of the cast. ecs-org-issuer (the ECS
# Ecosystem) issues its ECS Organization credential, and the agent issues its
# own ECS Service credential. Helvetia does not issue ECS Organization
# credentials on V4.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="helvetia-trust"
INGRESS_HOST="helvetia-trust.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-helvetia.sh"

# The organization of the agent: its Corporation owns the Participant entries.
CORPORATION_KEY="helvetia"

# Agent mode: standalone (its own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Helvetia Trust Services (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="CH"
ORG_REGISTRY_ID="CHE-105.987.654"
ORG_REGISTRY_URI="https://www.zefix.ch"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/helvetia-trust.svg"
ORG_ADDRESS="Bahnhofstrasse 21, 8001 Zurich, Switzerland"

# Service credential claims (self-issued)
SERVICE_NAME="Helvetia Trust Services (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="KYB verification services for the Vesta use case (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/helvetia-trust.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
