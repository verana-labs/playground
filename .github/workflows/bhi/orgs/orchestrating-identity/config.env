# =============================================================================
# Orchestrating Identity — certified Orchestration Service Provider (REAL org)
# =============================================================================
# The real partner appears as itself. It gets its ECS-Organization credential
# from ecs-org-issuer (the devnet ECS Ecosystem) and issues its own ECS-Service
# credential. It controls the DVS-Aligned Provider Ecosystem (demo), a
# registry that mirrors the OfDIA DVS register (it does not constitute it),
# and holds the ISSUER entry of that Ecosystem. It is a certified grantor of
# the Recruitment Trust Network: ISSUER_GRANTOR and ISSUER on Verified
# Employer, VERIFIER_GRANTOR on the candidate schemas (second pass of bhi-01).
# PENDING [SCOPE]: the Companies House number and exact DVS certification
# scope await written confirmation from OID — replace ORG_REGISTRY_ID before
# a provision run intended to stick.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="orchestrating-identity"
INGRESS_HOST="orchestrating-identity.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-orchestrating-identity.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="oid"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Orchestrating Identity"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/orchestrating-identity.svg"
ORG_REGISTRY_ID="UK-CH-PENDING-CONFIRMATION"
ORG_ADDRESS="London, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Orchestrating Identity"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Certified Orchestration Service Provider: onboards organisations onto the Recruitment Trust Network and operates the DVS-Aligned Provider Ecosystem (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/orchestrating-identity.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Ecosystem configuration (DVS-Aligned Provider Ecosystem (demo))
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
