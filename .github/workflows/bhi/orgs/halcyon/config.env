# =============================================================================
# Halcyon Talent (demo) — the impostor with real credentials
# =============================================================================
# Halcyon IS a verifiable organisation: an ECS-Organization credential from
# ecs-org-issuer and a self-issued ECS-Service credential, so Q1 resolves
# TRUSTED. It never gets a Verified Employer credential or a VERIFIER entry
# on the candidate schemas, by design: every compliant wallet refuses its
# requests before any data moves. Legitimate organisation, wrong network.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="halcyon"
INGRESS_HOST="halcyon.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-halcyon.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="halcyon"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Halcyon Talent (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/halcyon.svg"
ORG_REGISTRY_ID="UK-CH-00998877"
ORG_ADDRESS="99 Fast Lane, Birmingham, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Halcyon Talent (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Recruitment agency (demo): a verifiable organisation with no Verified Employer credential and no verifier permissions"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/halcyon.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DEMO ONLY (not in the spec): vs-agent v2 refuses to make a presentation
# request when the agent has no VERIFIER entry. This flag lets Halcyon make
# real requests all the same, so that the wallet refuses them on the missing
# entries. The V3 cast also asked for more claims than a verifier may ask
# for; an empty openid4vc.config cannot express that, so V4 does not show it.
UNSAFE_SKIP_OWN_AUTHORIZATION="true"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="verifier"
