# =============================================================================
# Northbank Identity (demo) — the certified DVS issuer of candidate creds
# =============================================================================
# It gets its ECS-Organization credential from ecs-org-issuer, issues its own
# ECS-Service credential, and controls an Ecosystem with the Right to Work
# schema (exactly one credential for each person) and the Employment schema
# (one credential for each employment; HMRC is the data source under the
# DUAA 2025 gateway, never the issuer). Verifier onboarding is through a
# GRANTOR: the certified DVS providers. The AnonCreds credential definitions
# serve the DIDComm rail; OID4VC_ROLE turns on the SD-JWT rail.
USER_ACC="bhi-playground-admin"
RELEASE_NAME="northbank"
INGRESS_HOST="northbank.bhi.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-northbank.sh"

# The organization of the agent (one Corporation for each organization).
CORPORATION_KEY="northbank"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Northbank Identity (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="GB"
ORG_REGISTRY_URI="https://find-and-update.company-information.service.gov.uk"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/northbank.svg"
ORG_REGISTRY_ID="UK-CH-00775533"
ORG_ADDRESS="1 Embankment Place, London, United Kingdom"

# Service credential claims (self-issued)
SERVICE_NAME="Northbank Identity (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Certified DVS provider (demo): issues the right-to-work and employment credentials, from HMRC payroll data under the DUAA 2025 gateway"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/northbank.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Ecosystem configuration (Right to Work and Employment)
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="issuer"
