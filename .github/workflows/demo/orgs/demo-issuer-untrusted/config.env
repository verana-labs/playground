# =============================================================================
# Untrusted Issuer (demo) — fails Q1, issuer side
# =============================================================================
# Deliberately unprovisioned (the umbra pattern): a vs-agent with a DID and
# NOTHING else. No ECS-Organization, no ECS-Service, no permissions. Offers a
# credential so the wallet exercises "an unknown service wants to issue to me",
# which is a different user journey from being asked for data. This service
# resolving as anything but UNTRUSTED is a paging incident (spec §6).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-issuer-untrusted"
INGRESS_HOST="demo-issuer-untrusted.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT=""
EXPOSE_ADMIN_API="false"

# Only used for the DIDComm label / invitation image (what a wallet sees)
SERVICE_NAME="Untrusted Issuer (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-untrusted.svg"
