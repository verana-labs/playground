# =============================================================================
# DarkPool Exchange (demo) - the outsider: verifiable, and NOT a member
# =============================================================================
# A real, verifiable exchange (ECS-Organization from Helvetia, self-issued
# ECS-Service) that never joined the Association. Deliberately no membership:
# no CEXA-VerifiedCounterparty, no permission on any CEXA schema. It runs the
# openid4vc verifier config and makes real presentation requests, so a wallet
# can be asked for the CEXA-Kyc by a trusted-but-unauthorized exchange and
# refuse at Q3. DarkPool appearing in either CEXA participant tree, or
# publishing a CEXA-VerifiedCounterparty VP, is a paging incident.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="darkpool"
INGRESS_HOST="darkpool.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-outsider.sh"
EXPOSE_ADMIN_API="false"
OID4VC_ROLE="verifier"
OID4VC_ISSUER_RELEASES="aurum novara"

# Organization credential claims (issued by Helvetia, Verana ECS Ecosystem)
ORG_NAME="DarkPool Exchange Ltd (demo)"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-darkpool.svg"
ORG_REGISTRY_ID="KY-338291"
ORG_ADDRESS="Harbour Place, George Town, Grand Cayman, Cayman Islands"
ORG_COUNTRY="KY"

# Service credential claims (self-issued)
SERVICE_NAME="DarkPool Exchange (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="A real crypto exchange (demo) outside the Crypto Exchange Association: verifiable, but not accredited to ask for the CEXA-Kyc credential"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-darkpool.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.31"
