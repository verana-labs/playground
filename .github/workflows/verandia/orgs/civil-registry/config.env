# =============================================================================
# SEGIP (demo) — the Republic's identity authority
# =============================================================================
# Receives ECS-Organization from the SEPREC (demo) (the Republic
# dogfoods its own register), self-issues ECS-Service, and owns the Bolivia
# Cedula Digital trust registry. Both directions are governed: issuance (only the
# Civil Registry issues) AND verification (relying parties must register as
# VERIFIER before any wallet shares a Cedula Digital — the eIDAS 2 relying-party
# rule, made structural).

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="segip"
INGRESS_HOST="segip.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-segip.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="SEGIP (demo)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/segip.svg"
ORG_REGISTRY_ID="BO-GOV-0002"
ORG_ADDRESS="Avenida da Republica 1, 1000 Alvorada, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="SEGIP (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="National identity authority of the Estado Plurinacional de Bolivia (demo): issues the Cedula Digital and governs its relying parties (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/segip.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Cedula Digital ecosystem)
SCHEMA_FILE="cedula-digital.json"
CUSTOM_SCHEMA_BASE_ID="cedula-digital"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT Cedula Digital offers for non-DIDComm wallets — the
# eIDAS-2-compatible rail): switches the deploy to the openid4vc image/chart
# and injects the issuer config. Role names select the template under
# bolivia/oid4vc/ — each Bolivia issuer advertises only the credential it is
# authorized to issue.
OID4VC_ROLE=issuer-cedula
