# =============================================================================
# Aurum Exchange (demo) — ISSUER + VERIFIER member
# =============================================================================
# A large exchange (standalone agent). It runs the full KYC through an
# EGF-authorized provider, seals the evidence into the wallet of the holder,
# issues the CEXAKycCredential for free, and gets the reuse fee when another
# member verifies its credentials. It gets its ECS Organization credential
# from ecs-org-issuer and its CEXAVerifiedCounterpartyCredential from the
# Association.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="aurum"
INGRESS_HOST="aurum.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-member.sh"

# The Corporation of the organization (did:example:playground-cexa-<key>-<chain id>).
CORPORATION_KEY="aurum"

# Agent mode: standalone (own ECS Organization credential).
AGENT_MODE="standalone"

# CEXAKycCredential Participant entries of this member: issuer and/or verifier
MEMBER_ROLES="issuer verifier"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Aurum Exchange (demo)"
ORG_ORGANIZATION_KIND="PRIVATE"
ORG_COUNTRY_CODE="CH"
ORG_REGISTRY_URI="https://www.zefix.ch"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-aurum.svg"
ORG_REGISTRY_ID="CHE-310.200.300"
ORG_ADDRESS="Bahnhofstrasse 21, 6300 Zug, Switzerland"

# Service credential claims (self-issued)
SERVICE_NAME="Aurum Exchange (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="CEXA member exchange (demo), accredited to issue and verify the CEXAKycCredential - one full check, reused everywhere"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-aurum.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CEXAVerifiedCounterpartyCredential claims (issued by the Association, EGF section 10)
CP_LEGAL_NAME="Aurum Exchange AG (demo)"
CP_LEI="529900AURUMDEMO00017"
CP_LICENSING_AUTHORITY="FINMA (demo)"
CP_LICENSE_IDENTIFIER="CH-VASP-2026-0142"
CP_VASP_CATEGORY="crypto exchange"
CP_COMPLIANCE_CONTACT="compliance@aurum.example"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin. The agent takes the
# credential types, the vct and the trust decision from the VPR.
OID4VC_ROLE="issuer"
