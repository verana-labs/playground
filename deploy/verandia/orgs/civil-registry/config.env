# =============================================================================
# National Civil Registry (demo) — the identity authority of the Republic
# =============================================================================
# A standalone agent with its own Corporation. ecs-org-issuer (the ECS
# ecosystem of the network) issues its ECS Organization credential, and the
# agent issues its own ECS Service credential.
#
# The registry controls the Verandia Citizen ID Ecosystem. Issuers AND
# verifiers onboard through the Ecosystem: a relying party must get a VERIFIER
# entry before a wallet shares a Citizen ID (the eIDAS 2 relying-party rule).
# The operator of this Corporation validates the VERIFIER entries of the relying
# parties (verandia-04, verandia-05). Holders are PERMISSIONLESS (personal
# wallets). The registry holds the only ISSUER entry on the schema, and issues
# on both rails (AnonCreds over DIDComm, SD-JWT over OpenID4VC).

USER_ACC="verandia-playground-admin"
RELEASE_NAME="civil-registry"
INGRESS_HOST="civil-registry.verandia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-registry.sh"

# The Corporation of the organization (see cast.sh)
CORPORATION_KEY="civil-registry"

# Agent mode: standalone (own ECS Organization credential)
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="National Civil Registry (demo)"
ORG_ORGANIZATION_KIND="PUBLIC"
ORG_COUNTRY_CODE="VD"
ORG_REGISTRY_URI="https://business-registry.verandia.playground.__NETWORK__.verana.network"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/civil-registry.svg"
ORG_REGISTRY_ID="VD-GOV-0002"
ORG_ADDRESS="Avenida da Republica 1, 1000 Alvorada, Republic of Verandia"

# Service credential claims (self-issued)
SERVICE_NAME="National Civil Registry (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="National identity authority of the Republic of Verandia: issues the Verandia Citizen ID and governs its relying parties (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/civil-registry.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Ecosystem configuration (Verandia Citizen ID)
SCHEMA_FILE="verandia-citizen-id.json"
SCHEMA_VERIFIER_MODE="ECOSYSTEM"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="issuer"
