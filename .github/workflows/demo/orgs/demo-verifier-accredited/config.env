# =============================================================================
# Accredited Verifier (demo) — TRUSTED, accredited to verify the DemoCredential
# =============================================================================
# Delegated ECS-Service issued by the Playground Demo anchor. Holds a
# self-created VERIFIER permission on the DemoCredential schema (verifier
# mode is OPEN): the Q3-pass card of every user-wallet playground page.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-verifier-accredited"
INGRESS_HOST="demo-verifier-accredited.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-demo-service.sh"
EXPOSE_ADMIN_API="false"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.3"

# Service credential claims (issued by the Playground Demo anchor)
SERVICE_NAME="Accredited Verifier (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Playground demo service authorized to verify the DemoCredential in the Playground Ecosystem (demo) — log in by presenting your DemoCredential"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-verifier.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DemoCredential permission for this service: issuer | verifier | none
DEMO_PERM="verifier"

# OpenID4VC SD-JWT rail: run the openid4vc image with the verifier config
# (issuer fingerprints are read live from the issuer agents at deploy time)
OID4VC_ROLE="verifier"
