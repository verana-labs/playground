# =============================================================================
# Untrusted Verifier (demo) — fails Q1, verifier side
# =============================================================================
# Deliberately unprovisioned (the umbra pattern): a vs-agent with a DID and
# NOTHING else. No ECS-Organization, no ECS-Service, no permissions. It does
# run the openid4vc image and make real presentation requests, so a wallet can
# be asked for data by a service it cannot trust-resolve and refuse at Q1.
# It is NOT in ISSUER_RELEASES, so no verifier pins its certificate.
# Resolving as anything but UNTRUSTED is a paging incident (spec §6).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-verifier-untrusted"
INGRESS_HOST="demo-verifier-untrusted.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT=""
EXPOSE_ADMIN_API="false"

# Agent mode: standalone (own ECS Organization credential) or delegated
# (ECS Service credential issued by the Playground Demo anchor).
AGENT_MODE="standalone"
OID4VC_ROLE="verifier"

# ECS Service claims. The agent needs them to start, but it never gets a
# credential: it never runs an onboarding process.
SERVICE_NAME="Untrusted Verifier (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-verifier-untrusted.svg"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Playground demo verifier with no ECS credentials. Wallets must refuse its requests."
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DEMO ONLY (not in the spec): vs-agent AGENT_UNSAFE_SKIP_OWN_AUTHORIZATION. The
# service makes offers and requests although it holds no DemoCredential
# Participant entry, so that wallets can show that they refuse them.
UNSAFE_SKIP_OWN_AUTHORIZATION="true"
