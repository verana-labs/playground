{
  "$comment": "Which build of each wallet to drive. `fork` is our Verana build (the APK personal-wallets.yaml links to), `store` is what a client actually downloads. A wallet with no store entry has no published Android build. Package, unlock recipe and secret belong to the BUILD, not the wallet: the store and fork builds of the same wallet routinely differ (Paradym's fork is biometric-only, its store build takes a PIN).",
  "builds": {
    "paradym": {
      "fork": {
        "package": "id.paradym.wallet.dev",
        "activity": ".MainActivity",
        "unlock": "biometric-only",
        "secret": null,
        "skip": "Biometric prompt with no PIN fallback."
      },
      "store": {
        "package": "id.paradym.wallet",
        "activity": ".MainActivity",
        "unlock": "keypad6-1234",
        "secret": "123456",
        "source": "https://play.google.com/store/apps/details?id=id.paradym.wallet",
        "version": "1.20.2"
      }
    },
    "hologram": {
      "fork": {
        "package": "io.twentysixty.mobileagent.st",
        "activity": "io.twentysixty.mobileagent.MainActivity",
        "unlock": "device-credential",
        "secret": "132006",
        "note": "Our INTEXUS-branded staging build: same code as the #514 fork, and unlike the .dev debug build it carries a JS bundle so it runs without Metro."
      },
      "store": {
        "package": "io.twentysixty.mobileagent.m",
        "activity": "io.twentysixty.mobileagent.MainActivity",
        "unlock": "device-credential",
        "secret": "132006",
        "source": "https://play.google.com/store/apps/details?id=io.twentysixty.mobileagent.m",
        "version": "2.0.0"
      }
    },
    "sphereon": {
      "fork": {
        "package": "com.sphereon.ssi.wallet",
        "activity": ".MainActivity",
        "unlock": "keypad6",
        "secret": "251839"
      },
      "store": {
        "package": "com.sphereon.ssi.wallet",
        "activity": ".MainActivity",
        "unlock": "keypad6",
        "secret": "251839",
        "source": "https://play.google.com/store/apps/details?id=com.sphereon.ssi.wallet",
        "note": "Same package id as our fork: installing one replaces the other, so the sweep must reinstall before switching build."
      }
    },
    "talao": {
