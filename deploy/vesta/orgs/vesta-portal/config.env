# =============================================================================
# Vesta Portal (demo) — badge login service (sub-service of Vesta)
# =============================================================================
# A delegated sub-service: the Vesta anchor issues its ECS Service credential,
# and it shares the ECS Organization credential of Vesta. It has an OPEN
# VERIFIER entry on the ECS Badge schema, so partner technicians log in with
# their badge.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="vesta-portal"
INGRESS_HOST="portal.vesta.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-portal.sh"

# A delegated sub-service uses the Corporation of its parent.
CORPORATION_KEY="vesta"

# Agent mode: delegated (the parent agent issues its ECS Service credential).
AGENT_MODE="delegated"
PARENT_HOST="vesta.playground.__NETWORK__.verana.network"

# Service credential claims (issued by the Vesta anchor)
SERVICE_NAME="Vesta Portal (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Authorized Repairer login portal of Vesta Appliances (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/vesta-portal.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT badge presentations): turn on the OpenID4VC plugin.
# The agent takes the trust decision on the badge issuer from the VPR.
OID4VC_ROLE="verifier"
