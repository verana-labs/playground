# =============================================================================
# Crypto Exchange Association (demo) — anchor of the CEXA cast
# =============================================================================
# The anchor VS of the Association: ECS-Organization issued by Helvetia (the
# Association is NOT an identity issuer — EGF section 4), self-issued
# ECS-Service, and owner of the CEXA trust registry with the CEXA-Kyc schema
# (governed both sides) and the CEXA-VerifiedCounterparty schema, anchored on
# the example EGF served by the playground itself.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="association"
INGRESS_HOST="association.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-association.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims (issued by Helvetia, Verana ECS Ecosystem)
ORG_NAME="Crypto Exchange Association (demo)"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-association.svg"
ORG_REGISTRY_ID="CHE-300.100.100"
ORG_ADDRESS="Trust Plaza 1, 6300 Zug, Switzerland"
ORG_COUNTRY="CH"

# Service credential claims (self-issued)
SERVICE_NAME="Crypto Exchange Association (demo)"
SERVICE_TYPE="TrustRegistryService"
SERVICE_DESCRIPTION="Anchor of the Crypto Exchange Association (demo): owns the CEXA trust registry, the CEXA-Kyc and CEXA-VerifiedCounterparty schemas, and anchors the example EGF"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-association.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration
KYC_SCHEMA_FILE="cexa-kyc.json"
COUNTERPARTY_SCHEMA_FILE="cexa-verified-counterparty.json"
EGF_DOC_URL="https://playground.testnet.verana.network/cexa/cexa-egf.md"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.31"
