# =============================================================================
# Evento Costa Rica — Revolución del Contenido Empresarial, 17 de septiembre
# =============================================================================
# El servicio del evento (la landing en /eventos/costa-rica): recibe su
# ECS-Organization de Helvetia Trust (demo) a nombre del organizador,
# INTEXUS, auto-emite su ECS-Service y se auto-registra como VERIFIER
# (verificación ABIERTA) de los esquemas Asistente y Patrocinador de
# Taquilla (demo). En la landing, el asistente presenta su boleto para
# entrar a su espacio personal; el patrocinador, a su espacio de patrocinador.
# PENDING: NIT y dirección de INTEXUS — confirmar con el socio antes de una
# ejecución definitiva (los valores de abajo son marcadores).

USER_ACC="eventos-playground-admin"
RELEASE_NAME="evento-costa-rica"
INGRESS_HOST="costa-rica.eventos.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-evento.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims (the organizer)
ORG_NAME="INTEXUS"
ORG_COUNTRY="CO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/eventos/intexus.png"
ORG_REGISTRY_ID="CO-NIT-pendiente"
ORG_ADDRESS="Colombia"

# Service credential claims (the event)
SERVICE_NAME="Revolución del Contenido Empresarial: Costa Rica"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Evento Revolucion del Contenido Empresarial en Costa Rica, 17 de septiembre de 2026: acceso al espacio personal del asistente y del patrocinador presentando el boleto emitido por Taquilla (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/eventos/cast/evento-costa-rica.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Taquilla schemas this event verifies
ASISTENTE_SCHEMA_BASE_ID="asistente"
PATROCINADOR_SCHEMA_BASE_ID="patrocinador"

# OpenID4VC rail (SD-JWT presentation requests); the issuer whose
# development-signing fingerprint gets pinned at render time — it must
# already run the openid4vc image (deploy Eventos 01 first).
OID4VC_ROLE=verifier
OID4VC_ISSUER_RELEASES="taquilla"
