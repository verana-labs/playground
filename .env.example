# Trust resolver (server-side; defaults to the public testnet resolver)
RESOLVER_URL=https://resolver.testnet.verana.network
# Demo services base domain (verana-demos deployment)
DEMOS_BASE_DOMAIN=main.demos.testnet.verana.network
# Extend the demo-service registry without code changes (JSON array).
# Entries may carry a literal did (external issuers) instead of host discovery.
# DEMO_SERVICES_EXTRA=[{"id":"fides-labs","label":"FIDES Labs Issuer (external)","host":"fides.acc.credenco.com","did":"did:web:fides.acc.credenco.com:did:da5a3c99-d45c-4ce2-8065-9db36c98868c","role":"issuer"}]
# FIDES award surface (banner renders only when set)
# NEXT_PUBLIC_FIDES_USECASE_URL=
