# =============================================================================
# Borealis Markets (demo) — VERIFIER member
# =============================================================================
# A growing exchange: accepts the CEXA-Kyc credential on sign-up (re-binding
# + paid session + evidence at presentation) instead of re-running the check.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="borealis"
INGRESS_HOST="borealis.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-member.sh"
EXPOSE_ADMIN_API="false"
MEMBER_ROLES="verifier"

# Organization credential claims (issued by Helvetia, Verana ECS Ecosystem)
ORG_NAME="Borealis Markets (demo)"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-borealis.svg"
ORG_REGISTRY_ID="16294901"
ORG_ADDRESS="Tornimäe 5, 10145 Tallinn, Estonia"
ORG_COUNTRY="EE"

# Service credential claims (self-issued)
SERVICE_NAME="Borealis Markets (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="CEXA member exchange (demo), accredited to verify the CEXA-Kyc credential - open an account by presenting it"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-borealis.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CEXA-VerifiedCounterparty claims (issued by the Association, EGF section 10)
CP_LEGAL_NAME="Borealis Markets OÜ (demo)"
CP_LEI=""
CP_LICENSING_AUTHORITY="Estonian FIU (demo)"
CP_LICENSE_IDENTIFIER="FVT000317"
CP_VASP_CATEGORY="crypto exchange"
CP_COMPLIANCE_CONTACT="compliance@borealis.example"

# OpenID4VC SD-JWT rail: verifier config (issuer fingerprints are read live
# from the issuer agents at deploy time)
OID4VC_ROLE="verifier"
OID4VC_ISSUER_RELEASES="aurum novara"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.31"
