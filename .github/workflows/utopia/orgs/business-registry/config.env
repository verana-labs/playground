# =============================================================================
# National Business Registry (demo) — the Republic's company register
# =============================================================================
# Receives ECS-Organization from Helvetia (KYB, trivial for a national
# institution), self-issues ECS-Service, and owns the Legal Representation
# trust registry with the Legal Representative schema (issuance
# ecosystem-governed, verification open). Its ISSUER accreditation on
# ECS-Organization — Business IDs from the register itself — is granted by
# the utopia-02 workflow (ECS ecosystem account). Once accredited, it issues
# the ECS-Organization credential of every other Utopia cast member.

USER_ACC="utopia-playground-admin"
RELEASE_NAME="business-registry"
INGRESS_HOST="business-registry.utopia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-business-registry.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="National Business Registry (demo)"
ORG_COUNTRY="UT"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/business-registry.svg"
ORG_REGISTRY_ID="UT-GOV-0001"
ORG_ADDRESS="Praca do Comercio 2, 1000 Alvorada, Republica of Utopia"

# Service credential claims
SERVICE_NAME="National Business Registry (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Company register of the Republica of Utopia: Business IDs and Legal Representative credentials (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/business-registry.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Legal Representation ecosystem)
SCHEMA_FILE="legal-representative.json"
CUSTOM_SCHEMA_BASE_ID="legal-representative"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT Legal Representative offers for non-DIDComm
# wallets): switches the deploy to the openid4vc image/chart and injects the
# issuer config. Role names select the template under utopia/oid4vc/ — each
# Utopia issuer advertises only the credential it is authorized to issue.
OID4VC_ROLE=issuer-legal-rep
