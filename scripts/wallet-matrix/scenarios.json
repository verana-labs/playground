        { "id": "employment", "service": "northbank", "credential": "bhi-employment", "kind": "issue", "expect": "accept" },
        { "id": "degree", "service": "caledonian", "credential": "bhi-qualification", "kind": "issue", "expect": "accept" },
        { "id": "certification", "service": "cirrus", "credential": "bhi-qualification", "kind": "issue", "expect": "accept" },
        { "id": "meridian-rtw", "service": "meridian-tech", "credential": "bhi-right-to-work", "kind": "present", "expect": "accept" },
        { "id": "meridian-employment", "service": "meridian-tech", "credential": "bhi-employment", "kind": "present", "expect": "accept" },
        { "id": "meridian-qualification", "service": "meridian-tech", "credential": "bhi-qualification", "kind": "present", "expect": "accept", "note": "Collect BOTH qualifications first: this is where a wallet without a per-query chooser submits two credentials and is rejected." },
        { "id": "halcyon", "service": "halcyon", "credential": "bhi-right-to-work", "kind": "present", "expect": "refuse", "note": "The point of the demo. Halcyon is a real verifiable company with no verifier permission." }
      ]
    },
    "vesta": {
      "page": "/usecases/vesta",
      "note": "Trust is not membership. All three organisations are verifiable and each holds a valid, unrevoked ISSUER permission on BadgeCredential (schema 250), so every badge issuance is correctly accepted. What separates them is the Authorized Repairer credential (schema 252, issued only by the Vesta Repair Network), which Umbra never receives. The refusal belongs at the portal, not at issuance.",
      "blocked": "swiyu rejects every service in this cast before any consent screen: the did:webvh logs were created on 2026-07-30 by a vs-agent older than the 2026-08-03 fix, so entry 1 signs its proof with a bare did:key: verification method and swiyu replays the log from version 1. Rolling the image forward does not help, the bad entries are immutable. Other wallets resolve these DIDs fine.",
      "scenarios": [
        { "id": "badge-vesta", "service": "vesta", "credential": "ecs-badge", "kind": "issue", "expect": "accept" },
        { "id": "badge-zenith", "service": "zenith", "credential": "ecs-badge", "kind": "issue", "expect": "accept" },
        { "id": "badge-umbra", "service": "umbra", "credential": "ecs-badge", "kind": "issue", "expect": "accept", "note": "Umbra issues real badges, so accepting here is correct. Expecting a refusal was wrong and made every wallet look broken." },
        { "id": "portal-login", "route": "/api/portal-login", "kind": "present", "expect": "accept", "note": "Present a badge issued by Vesta or Zenith." },
        { "id": "portal-login-umbra", "route": "/api/portal-login", "kind": "present", "expect": "refuse", "note": "Present an Umbra-issued badge. This is the scenario the cast exists for; it is not reachable from the runner, drive it from the page." }
      ]
    },
    "verandia": {
      "page": "/usecases/verandia",
      "scenarios": [
        { "id": "citizen-id", "service": "civil-registry", "credential": "verandia-citizen-id", "kind": "issue", "expect": "accept" },
        { "id": "legal-rep", "service": "business-registry", "credential": "verandia-legal-rep", "kind": "issue", "expect": "accept" },
        { "id": "login", "route": "/api/verandia-login", "kind": "present", "expect": "accept" }
      ]
    },
