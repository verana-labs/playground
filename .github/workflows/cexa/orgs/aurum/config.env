# =============================================================================
# Aurum Exchange (demo) — ISSUER + VERIFIER member
# =============================================================================
# A large exchange: runs the full KYC through an EGF-authorized provider,
# seals the evidence into the holder's wallet, issues CEXA-Kyc for free, and
# earns the reuse fee whenever another member verifies its credentials.

USER_ACC="vesta-playground-admin"
RELEASE_NAME="aurum"
INGRESS_HOST="aurum.cexa.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-member.sh"
EXPOSE_ADMIN_API="false"
MEMBER_ROLES="issuer verifier"

# Organization credential claims (issued by Helvetia, Verana ECS Ecosystem)
ORG_NAME="Aurum Exchange (demo)"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-aurum.svg"
ORG_REGISTRY_ID="CHE-310.200.300"
ORG_ADDRESS="Bahnhofstrasse 21, 6300 Zug, Switzerland"
ORG_COUNTRY="CH"

# Service credential claims (self-issued)
SERVICE_NAME="Aurum Exchange (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="CEXA member exchange (demo), accredited to issue and verify the CEXA-Kyc credential - one full check, reused everywhere"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/cexa-aurum.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# CEXA-VerifiedCounterparty claims (issued by the Association, EGF section 10)
CP_LEGAL_NAME="Aurum Exchange AG (demo)"
CP_LEI="529900AURUMDEMO00017"
CP_LICENSING_AUTHORITY="FINMA (demo)"
CP_LICENSE_IDENTIFIER="CH-VASP-2026-0142"
CP_VASP_CATEGORY="crypto exchange"
CP_COMPLIANCE_CONTACT="compliance@aurum.example"

# OpenID4VC SD-JWT rail: issuer config (vct on this host)
OID4VC_ROLE="issuer-aurum"

# vs-agent prerelease under test (overrides the template's image tag)
VS_AGENT_IMAGE_TAG="v1.12.0-oidc4vc-uiprofile.31"
