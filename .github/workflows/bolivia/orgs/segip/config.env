# =============================================================================
# SEGIP (demo) — Servicio General de Identificación Personal
# =============================================================================
# Recibe su ECS-Organization del SEPREC (el Estado usa su propio registro como
# fuente de verdad), auto-emite su ECS-Service, y gobierna la Red de Confianza
# SEGIP: emisión gobernada (solo el SEGIP emite la Cédula Digital, Ley 145) Y
# verificación gobernada (los verificadores deben registrarse como VERIFIER
# antes de que ninguna wallet comparta la cédula — la regla de parte
# informante de eIDAS 2, hecha estructura).

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="segip"
INGRESS_HOST="segip.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-segip.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="SEGIP (demo)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/segip.png"
ORG_REGISTRY_ID="BO-GOV-0002"
ORG_ADDRESS="Av. Camacho esq. Bueno, La Paz, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="SEGIP (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Servicio General de Identificación Personal (demo): emite la Cédula Digital del Estado Plurinacional de Bolivia y gobierna a sus verificadores autorizados (maqueta de demostración)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/segip.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Red de Confianza SEGIP)
SCHEMA_FILE="cedula-digital.json"
CUSTOM_SCHEMA_BASE_ID="cedula-digital"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (ofertas SD-JWT de la Cédula Digital para wallets sin
# DIDComm — el riel compatible con eIDAS 2): cambia el deploy a la imagen
# openid4vc e inyecta la configuración de emisor. El nombre de rol elige la
# plantilla bajo bolivia/oid4vc/ — cada emisor anuncia solo la credencial que
# está autorizado a emitir.
OID4VC_ROLE=issuer-cedula
