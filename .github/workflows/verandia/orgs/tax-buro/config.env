# =============================================================================
# Tax Buro (demo) — a registered relying party of the Republic
# =============================================================================
# A standalone agent with its own Corporation. ecs-org-issuer (the ECS
# ecosystem of the network) issues its ECS Organization credential, and the
# agent issues its own ECS Service credential.
#
# It holds two VERIFIER entries:
#   - on the Verandia Citizen ID (verifier mode ECOSYSTEM). The operator of the
#     Civil Registry Corporation validates it: the relying-party register.
#   - on the Legal Representative schema (verifier mode OPEN). The entry needs
#     no validation, but vs-agent v2 makes no request without it.
# Run verandia-01 and verandia-03 first.

USER_ACC="verandia-playground-admin"
RELEASE_NAME="tax-buro"
INGRESS_HOST="tax-buro.verandia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-relying-party.sh"

# The Corporation of the organization (see cast.sh)
CORPORATION_KEY="tax-buro"

# Agent mode: standalone (own ECS Organization credential)
AGENT_MODE="standalone"

# Organization credential claims. The agent sends them on its onboarding
# request to ecs-org-issuer (ECS_CLAIMS_ORG_* variables).
ORG_NAME="Tax Buro (demo)"
ORG_ORGANIZATION_KIND="PUBLIC"
ORG_COUNTRY_CODE="VD"
ORG_REGISTRY_URI="https://business-registry.verandia.playground.__NETWORK__.verana.network"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/tax-buro.svg"
ORG_REGISTRY_ID="VD-GOV-0003"
ORG_ADDRESS="Rua do Tesouro 8, 1000 Alvorada, Republic of Verandia"

# Service credential claims (self-issued)
SERVICE_NAME="Tax Buro (demo)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Tax portal of the Republic of Verandia: passwordless sign-in with the Verandia Citizen ID or a Legal Representative credential (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/tax-buro.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC SD-JWT rail: turn on the OpenID4VC plugin
OID4VC_ROLE="verifier"
