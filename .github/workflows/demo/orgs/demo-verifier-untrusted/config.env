# =============================================================================
# Untrusted Verifier (demo) — fails Q1, verifier side
# =============================================================================
# Deliberately unprovisioned (the umbra pattern): a vs-agent with a DID and
# NOTHING else. No ECS-Organization, no ECS-Service, no permissions. Requests a
# presentation so the wallet exercises "an unknown service wants my data", the
# Q1-fail card of every user-wallet playground page. This service resolving as
# anything but UNTRUSTED is a paging incident (spec §6).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-verifier-untrusted"
INGRESS_HOST="demo-verifier-untrusted.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT=""
EXPOSE_ADMIN_API="false"

# Only used for the DIDComm label / invitation image (what a wallet sees)
SERVICE_NAME="Untrusted Verifier (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-untrusted.svg"
