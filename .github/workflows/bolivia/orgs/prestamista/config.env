# =============================================================================
# Prestamista en línea (simulado) — el verificador que pide de más
# =============================================================================
# El prestamista SÍ es una empresa verificable: ECS-Organization del SEPREC y
# ECS-Service auto-emitida, así que Q1 resuelve TRUSTED. Lo que nunca obtiene
# (deliberadamente, jamás) es el permiso VERIFIER sobre la Cédula Digital: la
# verificación de ese esquema la gobierna el SEGIP, el prestamista nunca se
# registró como verificador, y toda wallet conforme rechaza su solicitud de
# presentación (Q3). Identidad probada no es autorización. Sin marca real:
# el actor rechazado de la historia es deliberadamente anónimo.

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="prestamista"
INGRESS_HOST="prestamista.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-prestamista.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Prestamista en línea (simulado)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/prestamista.svg"
ORG_REGISTRY_ID="BO-MAT-009913"
ORG_ADDRESS="Calle Comercio 999, La Paz, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="Prestamista en línea (simulado)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Prestamos de consumo (simulado): una empresa verificable SIN registro de verificador para la Cedula Digital"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/prestamista.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail: el prestamista emite solicitudes de presentación muy reales:
# el rechazo debe ocurrir en la wallet por el permiso VERIFIER ausente, no
# porque su botón esté muerto. La plantilla verifier-overasking pide la Cédula
# COMPLETA (fotografía incluida); las wallets conformes nunca le presentan.
OID4VC_ROLE=verifier-overasking
OID4VC_ISSUER_RELEASES="segip"
