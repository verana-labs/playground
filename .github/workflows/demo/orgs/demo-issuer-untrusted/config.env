# =============================================================================
# Untrusted Issuer (demo) — fails Q1, issuer side
# =============================================================================
# Deliberately unprovisioned (the umbra pattern): a vs-agent with a DID and
# NOTHING else. No ECS-Organization, no ECS-Service, no permissions. It does
# run the openid4vc image and mint real credential offers, because the point is
# to let a wallet receive an offer from a service it cannot trust-resolve and
# refuse it at Q1. Without OID4VC_ROLE it only speaks DIDComm, and Track B
# wallets have nothing to exercise. Resolving as anything but UNTRUSTED is a
# paging incident (spec §6).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="demo-issuer-untrusted"
INGRESS_HOST="demo-issuer-untrusted.playground.__NETWORK__.verana.network"
# Only the AnonCreds credential definition: no ECS onboarding, no Participant entry.
PROVISION_SCRIPT="provision-untrusted-service.sh"
EXPOSE_ADMIN_API="false"

# Agent mode: standalone (own ECS Organization credential) or delegated
# (ECS Service credential issued by the Playground Demo anchor).
AGENT_MODE="standalone"
OID4VC_ROLE="issuer"

# ECS Service claims. The agent needs them to start, but it never gets a
# credential: it never runs an onboarding process.
SERVICE_NAME="Untrusted Issuer (demo)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/demo-issuer-untrusted.svg"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Playground demo issuer with no ECS credentials. Wallets must refuse its offers."
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# DEMO ONLY (not in the spec): vs-agent AGENT_UNSAFE_SKIP_OWN_AUTHORIZATION. The
# service makes offers and requests although it holds no DemoCredential
# Participant entry, so that wallets can show that they refuse them.
UNSAFE_SKIP_OWN_AUTHORIZATION="true"

# AnonCreds cred def for the DemoCredential (linked to the ecosystem VTJSC),
# for the DIDComm offers.
DEMO_CREDDEF="true"
