# =============================================================================
# SEPREC (demo) — the Republic's company register
# =============================================================================
# Receives ECS-Organization from Helvetia (KYB, trivial for a national
# institution), self-issues ECS-Service, and owns the Legal Representation
# trust registry with the Legal Representative schema (issuance
# ecosystem-governed, verification open). Its ISSUER accreditation on
# ECS-Organization — Business IDs from the register itself — is granted by
# the bolivia-02 workflow (ECS ecosystem account). Once accredited, it issues
# the ECS-Organization credential of every other Bolivia cast member.

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="seprec"
INGRESS_HOST="seprec.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-seprec.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="SEPREC (demo)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/seprec.png"
ORG_REGISTRY_ID="BO-GOV-0001"
ORG_ADDRESS="Calle Mercado 1298, La Paz, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="SEPREC (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Servicio Plurinacional de Registro de Comercio (demo): matriculas como credenciales ECS-Organization y credenciales de Representante Legal (maqueta de demostracion)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/bolivia/seprec.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Legal Representation ecosystem)
SCHEMA_FILE="legal-representative.json"
CUSTOM_SCHEMA_BASE_ID="legal-representative"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail (SD-JWT Legal Representative offers for non-DIDComm
# wallets): switches the deploy to the openid4vc image/chart and injects the
# issuer config. Role names select the template under bolivia/oid4vc/ — each
# Bolivia issuer advertises only the credential it is authorized to issue.
OID4VC_ROLE=issuer-legal-rep
