# =============================================================================
# Prestamista en linea (simulado) — the over-asking verifier
# =============================================================================
# el prestamista IS a verifiable company: ECS-Organization from the National
# Business Registry and a self-issued ECS-Service, so Q1 resolves TRUSTED.
# What it never gets — deliberately, ever — is a VERIFIER permission on the
# Cedula Digital: verification of that schema is ecosystem-governed,
# el prestamista never registered as a relying party, and every compliant wallet
# refuses its presentation request (Q3). Trust is not authorization.

USER_ACC="bolivia-playground-admin"
RELEASE_NAME="prestamista"
INGRESS_HOST="prestamista.bolivia.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-prestamista.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Prestamista en linea (simulado)"
ORG_COUNTRY="BO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/prestamista.svg"
ORG_REGISTRY_ID="BO-REG-009913"
ORG_ADDRESS="Rua Rapida 99, 1300 Alvorada, Estado Plurinacional de Bolivia (demo)"

# Service credential claims
SERVICE_NAME="Prestamista en linea (simulado)"
SERVICE_TYPE="VerifierService"
SERVICE_DESCRIPTION="Consumer loan provider (demo) - a verifiable company with no relying-party registration for the Cedula Digital"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/cast/prestamista.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# OpenID4VC rail: el prestamista still mints very real presentation requests — the
# refusal must happen in the wallet on the missing VERIFIER permission, not
# because its request button is dead. The verifier-overasking template asks
# for the FULL Cedula Digital (portrait included) and pins no issuer
# fingerprints: compliant wallets never present to it anyway.
OID4VC_ROLE=verifier-overasking
