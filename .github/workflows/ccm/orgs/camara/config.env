# =============================================================================
# Cámara de Comercio de Medellín para Antioquia (demo) — la cámara emisora
# =============================================================================
# Recibe su ECS-Organization de Helvetia (KYB, trivial para la cámara que ES
# el registro), auto-emite su ECS-Service, y gobierna el Ecosistema Cámara de
# Comercio (demo) con el esquema de Representación Legal: emisión gobernada
# (solo la cámara emite) Y verificación gobernada (los verificadores deben
# registrarse ante la cámara — el asiento on-chain de la tarifa por
# verificación). Su acreditación ISSUER sobre ECS-Organization la otorga el
# workflow ccm-02 (cuenta del ecosistema ECS). En el despliegue objetivo,
# Confecámaras gobernaría el ecosistema y acreditaría a las 57 cámaras; la
# maqueta lo simplifica en la CCM.

USER_ACC="ccm-playground-admin"
RELEASE_NAME="camara"
INGRESS_HOST="camara.ccm.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-camara.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Cámara de Comercio de Medellín para Antioquia (demo)"
ORG_COUNTRY="CO"
ORG_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/ccm/ccm.png"
ORG_REGISTRY_ID="CO-CCM-0001"
ORG_ADDRESS="Calle 53 No. 45-77, Medellín, Colombia (demo)"

# Service credential claims
SERVICE_NAME="Cámara de Comercio de Medellín (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="Camara de Comercio de Medellin para Antioquia (demo): la prueba de representacion legal como credencial verificable, revocable el dia que cesa (maqueta de demostracion)"
SERVICE_LOGO_URL="https://raw.githubusercontent.com/verana-labs/playground/main/public/images/ccm/ccm.png"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Trust registry configuration (Ecosistema Cámara de Comercio (demo))
SCHEMA_FILE="representacion-legal.json"
CUSTOM_SCHEMA_BASE_ID="representacion-legal"
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"

# Root-permission fees, published on-chain with the schema (symbolic trust
# units standing in for the story's tariffs: el usuario paga la emisión como
# hoy paga el certificado, ~COP 12.100; el verificador paga COP 2.000 por
# verificación). The demo rails do not settle these fees at runtime yet —
# they document the business model in the public registry.
ISSUANCE_FEES="12"
VERIFICATION_FEES="2"

# OpenID4VC rail (ofertas SD-JWT de la credencial de Representación Legal
# para wallets sin DIDComm): cambia el deploy a la imagen openid4vc e
# inyecta la configuración de emisor. El nombre de rol elige la plantilla
# bajo ccm/oid4vc/.
OID4VC_ROLE=issuer-legal-rep
