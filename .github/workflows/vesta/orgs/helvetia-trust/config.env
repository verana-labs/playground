# =============================================================================
# Helvetia Trust Services (demo) — accredited ECS-Organization issuer (KYB)
# =============================================================================
# Bootstraps its own ECS-Organization from the ECS trust registry, then issues
# ECS-Organization credentials to the rest of the cast via its Admin API.
# Its ISSUER accreditation on the ECS-Organization schema is granted by the
# vesta-02 workflow (ECS ecosystem account).

USER_ACC="vesta-playground-admin"
RELEASE_NAME="helvetia-trust"
INGRESS_HOST="helvetia-trust.playground.__NETWORK__.verana.network"
PROVISION_SCRIPT="provision-helvetia.sh"
EXPOSE_ADMIN_API="false"

# Organization credential claims
ORG_NAME="Helvetia Trust Services (demo)"
ORG_COUNTRY="CH"
ORG_LOGO_URL="https://verana.io/logo.svg"
ORG_REGISTRY_ID="CHE-105.987.654"
ORG_ADDRESS="Bahnhofstrasse 21, 8001 Zurich, Switzerland"

# Service credential claims
SERVICE_NAME="Helvetia Trust Services (demo)"
SERVICE_TYPE="IssuerService"
SERVICE_DESCRIPTION="KYB verification and organization credential issuance for the Vesta use case (demo)"
SERVICE_LOGO_URL="https://verana.io/logo.svg"
SERVICE_MIN_AGE="0"
SERVICE_TERMS="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
SERVICE_PRIVACY="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
